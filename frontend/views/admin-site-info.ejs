<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Site Info' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>; --admin-accent: <%= design.adminColors.admin_accent %>; --admin-accent-dark: <%= design.adminColors.admin_accent_dark %>; --admin-text: <%= design.adminColors.admin_text %>; --admin-surface: <%= design.adminColors.admin_surface %>;">

<div class="admin-topbar">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <% if (design.images.logo || site.icon_path) { %>
                <img src="<%= design.images.logo || site.icon_path %>" alt="<%= site.legal_name %> logo" class="admin-logo-mark">
            <% } %>
            <h1 class="mb-0"><i class="fas fa-building me-2" style="color: var(--admin-accent);"></i>Site Info</h1>
        </div>
        <div class="me-2"><%- include('partials/language-switcher') %></div>
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<main class="admin-page-main">
<div class="container-fluid px-4 pb-5">

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <p class="text-muted">These values appear across the whole site: footer, contact page, About page, and page titles. Changes apply immediately.</p>
            <form method="POST" action="/admin/site-info">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Legal Name</label>
                        <input type="text" name="legal_name" class="form-control" value="<%= site.legal_name %>">
                        <div class="form-text">Appears in: footer, About page, browser page titles, SEO tags</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Short Name</label>
                        <input type="text" name="short_name" class="form-control" value="<%= site.short_name %>">
                        <div class="form-text">Appears in: navbar next to the logo, most page titles</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Company Name</label>
                        <input type="text" name="company_name" class="form-control" value="<%= site.company_name %>">
                        <div class="form-text">Appears in: homepage browser tab title only</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <input type="text" name="address" class="form-control" value="<%= site.address %>">
                        <div class="form-text">Appears in: footer (on every page)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">City / Location</label>
                        <input type="text" name="location" class="form-control" value="<%= site.location %>">
                        <div class="form-text">Appears in: footer, About page intro, Contact page</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Postal Code</label>
                        <input type="text" name="postal_code" class="form-control" value="<%= site.postal_code %>">
                        <div class="form-text">Appears in: footer, next to the location</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">GST Number</label>
                        <input type="text" name="gst" class="form-control" value="<%= site.gst %>">
                        <div class="form-text">Appears in: footer only</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="<%= site.email %>">
                        <div class="form-text">Appears in: footer (as a mailto link), Contact page</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone (displayed, e.g. +91 98765 43210)</label>
                        <input type="text" name="phone_display" class="form-control" value="<%= site.phone_display %>">
                        <div class="form-text">Appears in: footer, Contact page (the readable number shown to visitors)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone (for tel: link, e.g. +919876543210)</label>
                        <input type="text" name="phone_href" class="form-control" value="<%= site.phone_href %>">
                        <div class="form-text">Used by: the "Call Now" button and footer phone link (no spaces/dashes)</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">WhatsApp Link (e.g. https://wa.me/919876543210)</label>
                        <input type="text" name="whatsapp_href" class="form-control" value="<%= site.whatsapp_href %>">
                        <div class="form-text">Used by: the floating WhatsApp button shown on every page</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Default Site Description (used for SEO)</label>
                        <textarea name="default_description" class="form-control" rows="2"><%= site.default_description %></textarea>
                        <div class="form-text">Used by: search engines and social media link previews (not visible on the page itself)</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Google Analytics Measurement ID (optional)</label>
                        <input type="text" name="analytics_id" class="form-control" value="<%= site.analytics_id || '' %>" placeholder="G-XXXXXXXXXX">
                        <div class="form-text">From your Google Analytics 4 property (Admin &rarr; Data Streams). Leave blank to disable visitor tracking.</div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Save Site Info</button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1"><i class="fas fa-heading me-2" style="color: var(--admin-accent);"></i>Page Text</h4>
            <p class="text-muted">Headings, kickers, and intro text shown on the Home, Services, About, and Contact pages. Leave a field blank and Save to keep its current value &mdash; it won't be cleared.</p>
            <form method="POST" action="/admin/site-info">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Home &mdash; Hero</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="home_hero_kicker" class="form-control" value="<%= site.home_hero_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Headline</label><input type="text" name="home_hero_title" class="form-control" value="<%= site.home_hero_title %>"></div>
                    <div class="col-12"><label class="form-label">Subheadline</label><textarea name="home_hero_description" class="form-control" rows="2"><%= site.home_hero_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Home &mdash; Services Section</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="home_services_kicker" class="form-control" value="<%= site.home_services_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Heading</label><input type="text" name="home_services_heading" class="form-control" value="<%= site.home_services_heading %>"></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea name="home_services_description" class="form-control" rows="2"><%= site.home_services_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Home &mdash; About Section</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="home_about_kicker" class="form-control" value="<%= site.home_about_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Heading</label><input type="text" name="home_about_heading" class="form-control" value="<%= site.home_about_heading %>"></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Home &mdash; Research Verticals Section</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="home_research_kicker" class="form-control" value="<%= site.home_research_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Heading</label><input type="text" name="home_research_heading" class="form-control" value="<%= site.home_research_heading %>"></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea name="home_research_description" class="form-control" rows="2"><%= site.home_research_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Home &mdash; Testimonials Section</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="home_testimonials_kicker" class="form-control" value="<%= site.home_testimonials_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Heading</label><input type="text" name="home_testimonials_heading" class="form-control" value="<%= site.home_testimonials_heading %>"></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea name="home_testimonials_description" class="form-control" rows="2"><%= site.home_testimonials_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Services Page &mdash; Hero</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="services_hero_kicker" class="form-control" value="<%= site.services_hero_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Headline</label><input type="text" name="services_hero_title" class="form-control" value="<%= site.services_hero_title %>"></div>
                    <div class="col-12"><label class="form-label">Subheadline</label><textarea name="services_hero_description" class="form-control" rows="2"><%= site.services_hero_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Services Page &mdash; Offer Section</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="services_offer_kicker" class="form-control" value="<%= site.services_offer_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Heading</label><input type="text" name="services_offer_heading" class="form-control" value="<%= site.services_offer_heading %>"></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea name="services_offer_description" class="form-control" rows="2"><%= site.services_offer_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Services Page &mdash; Process Section</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Kicker</label><input type="text" name="services_process_kicker" class="form-control" value="<%= site.services_process_kicker %>"></div>
                    <div class="col-md-8"><label class="form-label">Heading</label><input type="text" name="services_process_heading" class="form-control" value="<%= site.services_process_heading %>"></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea name="services_process_description" class="form-control" rows="2"><%= site.services_process_description %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">About Page</h6>
                <div class="row g-3">
                    <div class="col-12"><label class="form-label">Headline</label><input type="text" name="about_heading" class="form-control" value="<%= site.about_heading %>"></div>
                    <div class="col-12"><label class="form-label">Second Paragraph</label><textarea name="about_paragraph2" class="form-control" rows="2"><%= site.about_paragraph2 %></textarea></div>
                </div>

                <h6 class="fw-bold mt-4 mb-3 text-uppercase small text-muted">Contact Page</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Heading</label><input type="text" name="contact_heading" class="form-control" value="<%= site.contact_heading %>"></div>
                    <div class="col-md-8"><label class="form-label">Subheading</label><input type="text" name="contact_subheading" class="form-control" value="<%= site.contact_subheading %>"></div>
                </div>

                <button type="submit" class="btn btn-primary mt-4">Save Page Text</button>
            </form>
        </div>
    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
