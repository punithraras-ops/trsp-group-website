<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="hero text-center text-white d-flex align-items-center">
    <div class="container">
        <div data-aos="fade-up">
            <i class="<%= heroIcon %> fa-5x mb-4 text-white opacity-80"></i>
            <h1 class="display-3 fw-bold"><%= heroTitle %></h1>
            <p class="lead mb-5"><%= heroSubtitle %></p>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-5" data-aos="fade-up">Key Features &amp; Capabilities</h2>

        <div class="row g-5">
            <% features.forEach((feature, index) => { %>
                <div class="col-lg-6" data-aos="<%= index % 2 === 0 ? 'fade-right' : 'fade-left' %>">
                    <div class="feature-item p-4 rounded shadow-sm bg-white mb-4 h-100">
                        <h4 class="text-primary fw-bold"><%= feature.title %></h4>
                        <p class="mb-0"><%= feature.description %></p>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (typeof portfolio !== 'undefined' && portfolio && portfolio.length > 0) { %>
            <h2 class="text-center fw-bold mb-5 mt-5" data-aos="fade-up">Our Software Portfolio</h2>
            <p class="text-center lead mb-5">Examples of application experiences that can be adapted for your business goals.</p>

            <div class="row g-4 justify-content-center">
                <% portfolio.forEach((project, index) => { %>
                    <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="<%= index * 200 %>">
                        <div class="portfolio-item shadow-lg rounded overflow-hidden h-100">
                            <img src="<%= project.image %>" alt="<%= project.title %>" class="img-fluid">
                            <div class="p-3 text-center bg-white h-100">
                                <h5><%= project.title %></h5>
                                <p class="mb-0"><%= project.description %></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <div class="text-center mt-5">
            <a href="<%= site.routes.contact %>?service=<%= serviceKey %>" class="btn btn-primary btn-lg shadow">Discuss Your Project</a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
