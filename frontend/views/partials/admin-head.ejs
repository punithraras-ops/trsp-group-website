<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof adminPageTitle !== 'undefined' ? adminPageTitle : (site.short_name + ' - Admin') %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <% if (typeof design !== 'undefined') { %>
    <style>
        <%
        const adminButtonSlots = [
            { key: 'admin_btn_tickets', selector: '.admin-nav-tickets' },
            { key: 'admin_btn_siteinfo', selector: '.admin-nav-siteinfo' },
            { key: 'admin_btn_sitedesign', selector: '.admin-nav-sitedesign' },
            { key: 'admin_btn_legal', selector: '.admin-nav-legal' },
            { key: 'admin_btn_coupons', selector: '.admin-nav-coupons' },
            { key: 'admin_btn_auditlog', selector: '.admin-nav-auditlog' },
            { key: 'admin_btn_security', selector: '.admin-nav-security' },
            { key: 'admin_btn_logout', selector: '.admin-nav-logout' },
        ];
        %>
        <% adminButtonSlots.forEach(btn => { %>
            <% const customColor = design.adminButtonColors && design.adminButtonColors[btn.key]; %>
            <% const customImage = design.images && design.images[btn.key]; %>
            <% if (customColor || customImage) { %>
            body.admin-page <%= btn.selector %> {
                <% if (customImage) { %>
                background-image: linear-gradient(rgba(15, 23, 42, 0.45), rgba(15, 23, 42, 0.45)), url('<%= customImage %>');
                background-size: cover;
                background-position: center;
                border-color: transparent;
                color: #ffffff !important;
                <% } else if (customColor) { %>
                background: linear-gradient(180deg, color-mix(in srgb, <%= customColor %> 100%, white 18%), <%= customColor %> 60%, color-mix(in srgb, <%= customColor %> 100%, black 15%));
                border-color: color-mix(in srgb, <%= customColor %> 100%, black 15%);
                color: #ffffff !important;
                <% } %>
            }
            body.admin-page <%= btn.selector %>:hover {
                filter: brightness(1.08);
                transform: translateY(-2px);
            }
            <% } %>
        <% }) %>
    </style>
    <% } %>
</head>
