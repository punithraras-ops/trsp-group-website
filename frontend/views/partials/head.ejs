<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= pageDescription %>">
    <title><%= pageTitle %></title>
    <link rel="icon" type="image/png" sizes="32x32" href="<%= design.images.favicon || '/img/favicon-32.png' %>">
    <link rel="icon" type="image/png" sizes="512x512" href="<%= design.images.favicon || '/img/favicon.png' %>">
    <link rel="apple-touch-icon" href="<%= design.images.favicon || '/img/apple-touch-icon.png' %>">
    <link rel="canonical" href="<%= site.site_url + currentPath %>">

    <% if (site.analytics_id) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.analytics_id %>"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= site.analytics_id %>');
    </script>
    <% } %>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= site.legal_name %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:image" content="<%= site.site_url + site.logo_path %>">
    <meta property="og:url" content="<%= site.site_url + currentPath %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="<%= site.site_url + site.logo_path %>">

    <script type="application/ld+json">
    <%- JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.legal_name,
        url: site.site_url,
        logo: site.site_url + site.logo_path,
        email: site.email,
        address: {
            '@type': 'PostalAddress',
            addressLocality: site.location,
            postalCode: site.postal_code,
            addressCountry: 'IN',
        },
    }) %>
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: <%= design.colors.primary_color %>;
            --primary-dark: <%= design.colors.primary_dark %>;
            --dark-color: <%= design.colors.dark_color %>;
            --light-color: <%= design.colors.light_color %>;
            --text-color: <%= design.colors.text_color %>;
            --heading-color: <%= design.colors.heading_color %>;
            --card-bg: <%= design.colors.card_background_color || '#ffffff' %>;
        }
        <% if (design.images.hero_background) { %>
        .hero {
            background-image: linear-gradient(135deg, rgba(9, 22, 35, 0.75), rgba(26, 114, 132, 0.65)), url('<%= design.images.hero_background %>');
        }
        <% } %>
        <% if (design.images.page_background) { %>
        body {
            background-image:
                radial-gradient(ellipse at 50% 110%, rgba(0, 0, 0, 0.35), transparent 55%),
                radial-gradient(ellipse at 50% -10%, rgba(0, 0, 0, 0.2), transparent 45%),
                url('<%= design.images.page_background %>');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
        <% } %>
        <% if (design.images.services_background) { %>
        #services {
            position: relative;
            background-image:
                linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.88)),
                url('<%= design.images.services_background %>');
            background-size: cover;
            background-position: center;
        }
        <% } %>
        <% if (design.images.button_background) { %>
        .btn-primary, .nav-link-cta {
            background-image:
                linear-gradient(180deg, color-mix(in srgb, var(--primary-color) 100%, white 18%) 0%, color-mix(in srgb, var(--primary-color) 80%, transparent) 55%, color-mix(in srgb, var(--primary-dark) 80%, transparent) 100%),
                url('<%= design.images.button_background %>');
            background-size: cover;
            background-position: center;
        }
        <% } %>
        <%
        const navButtonImages = [
            { key: 'nav_home_bg', selector: '.nav-link-home', style: 'dark' },
            { key: 'nav_services_bg', selector: '.nav-link-services', style: 'dark' },
            { key: 'nav_store_bg', selector: '.nav-link-store', style: 'dark' },
            { key: 'nav_contact_bg', selector: '.nav-link-contact', style: 'dark' },
            { key: 'nav_about_bg', selector: '.nav-link-about', style: 'dark' },
            { key: 'nav_language_bg', selector: '.lang-dropdown-btn', style: 'dark' },
            { key: 'nav_login_bg', selector: '.nav-link-login', style: 'primary' },
            { key: 'service_cta_bg', selector: '.service-card-button', style: 'primary' },
        ];
        %>
        <% navButtonImages.forEach(btn => { %>
            <% if (design.images[btn.key]) { %>
            <%= btn.selector %> {
                <% if (btn.style === 'dark') { %>
                background-image: linear-gradient(rgba(8, 20, 33, 0.55), rgba(8, 20, 33, 0.55)), url('<%= design.images[btn.key] %>');
                <% } else { %>
                background-image: linear-gradient(180deg, color-mix(in srgb, var(--primary-color) 100%, white 18%) 0%, color-mix(in srgb, var(--primary-color) 80%, transparent) 55%, color-mix(in srgb, var(--primary-dark) 80%, transparent) 100%), url('<%= design.images[btn.key] %>');
                <% } %>
                background-size: cover;
                background-position: center;
            }
            <% } %>
        <% }) %>
    </style>
</head>
<body data-page="<%= activePage %>">
