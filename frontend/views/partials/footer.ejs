    </main>

    <footer class="footer py-5">
        <div class="container-fluid px-4 px-xl-5 text-center text-md-start">
            <div class="row align-items-start">
                <div class="col-md-6 mb-4">
                    <h5 class="fw-bold"><%= site.legal_name %></h5>
                    <p><%= site.address %><br><%= site.location %> - <%= site.postal_code %><br>GST: <%= site.gst %></p>
                </div>
                <div class="col-md-6 mb-4">
                    <h5 class="fw-bold"><%= site.footer_contact_heading %></h5>
                    <p>Email: <a href="mailto:<%= site.email %>"><%= site.email %></a><br>Phone: <a href="tel:<%= site.phone_href %>"><%= site.phone_display %></a></p>
                </div>
            </div>
            <hr class="my-4">
            <p class="text-center mb-2"><a href="/terms"><%= site.footer_terms_label %></a> &middot; <a href="/privacy"><%= site.footer_privacy_label %></a></p>
            <p class="text-center mb-0">&copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. <%= site.footer_rights_text %></p>
        </div>
    </footer>

    <a href="<%= site.whatsapp_href %>" class="whatsapp-btn shadow-lg" target="_blank" rel="noreferrer">
        <i class="fab fa-whatsapp fa-2x"></i>
    </a>

    <%- include('login-modal') %>
    <%- include('confirm-modal') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="/js/csrf.js"></script>
    <script src="/js/script.js"></script>
    <script src="/js/click-sound.js"></script>
    <script src="/js/translate-widget.js"></script>
    <script src="/js/confirm-modal.js"></script>
    <script src="/js/cart.js"></script>
</body>
</html>
