<% /* locals: color (hex string|falsy), image (url string|falsy), overlay ('light'|'dark') */ %>
<% if (typeof color !== 'undefined' && color) { %>background-color: <%= color %>;<% } %><% if (typeof image !== 'undefined' && image) { %> background-image: linear-gradient(<%= overlay === 'dark' ? 'rgba(10,24,40,0.78), rgba(10,24,40,0.78)' : 'rgba(255,255,255,0.86), rgba(255,255,255,0.86)' %>), url('<%= image %>'); background-size: cover; background-position: center;<% } %>
