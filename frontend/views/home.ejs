<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="hero hero-home text-center text-white d-flex align-items-center">
    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-xl-9" data-aos="fade-up">
                <span class="hero-kicker"><%= site.home_hero_kicker %></span>
                <h1 class="hero-title display-2 fw-bold mb-4"><%= site.home_hero_title %></h1>
                <p class="hero-description lead mb-5"><%= site.home_hero_description %></p>

                <div class="hero-actions d-flex flex-column flex-sm-row justify-content-center gap-3 mb-5">
                    <a href="<%= site.routes.contact %>" class="btn btn-primary btn-lg shadow"><%= site.home_hero_btn1_label %></a>
                    <a href="tel:<%= site.phone_href %>" class="btn btn-outline-light btn-lg shadow"><%= site.home_hero_btn2_label %></a>
                </div>

                <div class="hero-pillbar d-flex flex-wrap justify-content-center gap-3">
                    <% services.forEach(service => { %>
                        <span class="hero-pill"><%= service.title %></span>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light" id="services">
    <div class="container">
        <div class="section-heading text-center mx-auto" data-aos="fade-up">
            <span class="section-eyebrow"><%= site.home_services_kicker %></span>
            <h2 class="display-4 fw-bold mb-3"><%= site.home_services_heading %></h2>
            <p class="section-description"><%= site.home_services_description %></p>
        </div>

        <% if (!dbConfigured) { %>
            <div class="alert alert-info text-center">Services are being configured. Please check back soon.</div>
        <% } else if (services.length === 0) { %>
            <div class="alert alert-info text-center">No services published yet.</div>
        <% } else { %>
        <div class="row g-4 justify-content-center">
            <% services.forEach((service, index) => { %>
                <div class="col-xl-3 col-lg-6 col-md-6" data-aos="zoom-in" data-aos-delay="<%= index * 100 %>">
                    <article class="card service-card h-100 border-0 shadow-lg" <% if (service.background_color || service.background_image) { %>style="<%- include('partials/frame-bg-style', { color: service.background_color, image: service.background_image, overlay: 'light' }) %>"<% } %>>
                        <div class="card-body d-flex flex-column">
                            <div class="service-card-header">
                                <span class="service-icon-wrap">
                                    <i class="<%= service.icon %>" aria-hidden="true"></i>
                                </span>
                            </div>

                            <div class="service-card-content mb-4">
                                <h3 class="service-card-title"><%= service.title %></h3>
                                <p class="card-text text-muted mb-0"><%= service.summary %></p>
                            </div>

                            <a href="/services/<%= service.slug %>" class="btn btn-primary service-card-button mt-auto">
                                <%= service.cta_label %> <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                </div>
            <% }) %>
        </div>
        <% } %>

        <div class="text-center mt-5">
            <a href="<%= site.routes.services %>" class="btn btn-primary btn-lg shadow">View All Services</a>
        </div>
    </div>
</section>

<section class="section-padding section-soft">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="section-eyebrow"><%= site.home_about_kicker %></span>
                <h2 class="display-5 fw-bold mb-4"><%= site.home_about_heading %></h2>
                <p class="lead"><%= site.short_name %> is a technology-focused organization based in <%= site.location %>, helping teams modernize operations and launch better digital experiences.</p>
                <p><%= site.home_about_paragraph2 %></p>

                <div class="about-mini-grid">
                    <div class="about-mini-card" <% if (design.cardColors.home_about_mission_card_bg || design.images.home_about_mission_card_bg) { %>style="<%- include('partials/frame-bg-style', { color: design.cardColors.home_about_mission_card_bg, image: design.images.home_about_mission_card_bg, overlay: 'light' }) %>"<% } %>>
                        <h3><%= site.home_about_mission_title %></h3>
                        <p><%= site.home_about_mission_text %></p>
                    </div>
                    <div class="about-mini-card" <% if (design.cardColors.home_about_approach_card_bg || design.images.home_about_approach_card_bg) { %>style="<%- include('partials/frame-bg-style', { color: design.cardColors.home_about_approach_card_bg, image: design.images.home_about_approach_card_bg, overlay: 'light' }) %>"<% } %>>
                        <h3><%= site.home_about_approach_title %></h3>
                        <p><%= site.home_about_approach_text %></p>
                    </div>
                </div>

                <a href="<%= site.routes.about %>" class="btn btn-primary shadow mt-4"><%= site.home_about_btn_label %> <i class="fas fa-arrow-right ms-2"></i></a>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <div class="about-visual-shell">
                    <img src="<%= design.images.team_photo || '/img/placeholder-team.svg' %>" alt="Technical of RSP Groups Team" class="img-fluid rounded shadow-lg">
                </div>
            </div>
        </div>
    </div>
</section>

<% if (typeof upcomingFeatures !== 'undefined' && upcomingFeatures.length > 0) { %>
<section class="section-padding bg-light" id="upcoming-features">
    <div class="container">
        <div class="section-heading text-center mx-auto" data-aos="fade-up">
            <span class="section-eyebrow"><%= site.home_upcoming_kicker %></span>
            <h2 class="display-5 fw-bold mb-3"><%= site.home_upcoming_heading %></h2>
            <p class="section-description"><%= site.home_upcoming_description %></p>
        </div>

        <div class="row g-4 justify-content-center">
            <% upcomingFeatures.forEach(feature => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card research-card h-100 shadow-lg border-0 rounded-4" <% if (feature.background_color || feature.background_image) { %>style="<%- include('partials/frame-bg-style', { color: feature.background_color, image: feature.background_image, overlay: 'light' }) %>"<% } %>>
                        <div class="card-body p-4">
                            <span class="badge bg-primary mb-3 text-uppercase"><%= feature.status %></span>
                            <h4 class="card-title fw-bold mb-3"><%= feature.title %></h4>
                            <p class="card-text text-muted"><%= feature.description %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<section class="section-padding bg-light" id="research-verticals">
    <div class="container">
        <div class="section-heading text-center mx-auto" data-aos="fade-up">
            <span class="section-eyebrow"><%= site.home_research_kicker %></span>
            <h2 class="display-5 fw-bold mb-3"><%= site.home_research_heading %></h2>
            <p class="section-description"><%= site.home_research_description %></p>
        </div>

        <div class="row g-4 justify-content-center">
            <% researchVerticals.forEach(vertical => { %>
                <div class="col-lg-4 col-md-6">
                    <div class="card research-card h-100 shadow-lg border-0 rounded-4" <% if (vertical.background_color || vertical.background_image) { %>style="<%- include('partials/frame-bg-style', { color: vertical.background_color, image: vertical.background_image, overlay: 'light' }) %>"<% } %>>
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold text-primary mb-3"><%= vertical.title %></h4>
                            <p class="card-text text-muted"><%= vertical.summary %></p>

                            <button class="btn btn-link text-primary p-0 mt-3 fw-medium collapse-btn collapsed" data-bs-toggle="collapse" data-bs-target="#<%= vertical.id %>" aria-expanded="false" aria-controls="<%= vertical.id %>">
                                View Research Areas <i class="fas fa-chevron-down ms-2"></i>
                            </button>

                            <div class="collapse mt-4" id="<%= vertical.id %>">
                                <ul class="list-unstyled mb-0">
                                    <% vertical.areas.forEach(area => { %>
                                        <li class="mb-2"><%= area %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<section class="section-padding testimonial-section text-white py-5">
    <div class="container">
        <div class="section-heading text-center mx-auto" data-aos="fade-up">
            <span class="section-eyebrow section-eyebrow-light"><%= site.home_testimonials_kicker %></span>
            <h2 class="display-5 fw-bold mb-3 text-white"><%= site.home_testimonials_heading %></h2>
            <p class="section-description text-white-50"><%= site.home_testimonials_description %></p>
        </div>

        <div id="testimonialCarousel" class="carousel slide testimonial-carousel" data-bs-ride="carousel">
            <div class="carousel-inner">
                <% testimonials.forEach((testimonial, index) => { %>
                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                        <div class="testimonial-card text-center mx-auto" <% if (testimonial.background_color || testimonial.background_image) { %>style="<%- include('partials/frame-bg-style', { color: testimonial.background_color, image: testimonial.background_image, overlay: 'dark' }) %>"<% } %>>
                            <p class="lead fs-4 mb-4">"<%= testimonial.quote %>"</p>
                            <h5 class="text-white mb-0">- <%= testimonial.author %></h5>
                        </div>
                    </div>
                <% }) %>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
