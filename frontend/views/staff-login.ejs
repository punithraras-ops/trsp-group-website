<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Store Staff Login' }) %>
<body class="admin-auth-page d-flex align-items-center justify-content-center" style="min-height: 100vh;">
<div class="card border-0 shadow-lg rounded-4" style="width: 100%; max-width: 400px;">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <i class="fas fa-headset" style="font-size: 2rem; color: #4f46e5;"></i>
        </div>
        <h3 class="fw-bold text-center mb-4">Store Staff Login</h3>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/staff/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/staff/tickets' %>">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control form-control-lg" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control form-control-lg" required>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>
        </form>
        <div class="text-center mt-3 text-muted small">
            Forgot your password? Contact your administrator.
        </div>
    </div>
</div>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
