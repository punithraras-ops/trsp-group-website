<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Terms & Conditions' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>;">

<div class="admin-topbar">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3" style="max-width: 900px;">
        <h1><i class="fas fa-file-contract me-2" style="color: var(--admin-accent);"></i>Terms &amp; Conditions</h1>
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<main class="admin-page-main">
<div class="container pb-5" style="max-width: 900px;">

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <p class="text-muted">This text is shown publicly at <a href="/terms" target="_blank">/terms</a> and linked from the site footer on every page. Covers website usage and payment terms - edit freely as plain text; line breaks are preserved exactly as typed.</p>
            <form method="POST" action="/admin/legal">
                <textarea name="terms" class="form-control" rows="28" style="font-family: 'Inter', monospace; font-size: 0.92rem;" required><%= terms %></textarea>
                <button type="submit" class="btn btn-primary mt-3"><i class="fas fa-floppy-disk me-2"></i>Save Terms &amp; Conditions</button>
            </form>
        </div>
    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<script src="/js/click-sound.js"></script>
</body>
</html>
