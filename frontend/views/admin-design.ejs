<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= site.short_name %> - Site Design</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-page" style="background: <%= design.adminBackground %>;">
<div class="container py-5" style="max-width: 760px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold mb-0">Site Design</h1>
        <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Colors</h4>
            <p class="text-muted">Controls buttons, links, dark backgrounds (navbar, footer, hero), body text, headings, and the page background across the whole site.</p>
            <form method="POST" action="/admin/design/colors">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary (buttons/links)</label>
                        <input type="color" name="primary_color" class="form-control form-control-color" value="<%= colors.primary_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary Hover</label>
                        <input type="color" name="primary_dark" class="form-control form-control-color" value="<%= colors.primary_dark %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Dark (navbar/footer)</label>
                        <input type="color" name="dark_color" class="form-control form-control-color" value="<%= colors.dark_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Page Background</label>
                        <input type="color" name="light_color" class="form-control form-control-color" value="<%= colors.light_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Body Text</label>
                        <input type="color" name="text_color" class="form-control form-control-color" value="<%= colors.text_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Headings</label>
                        <input type="color" name="heading_color" class="form-control form-control-color" value="<%= colors.heading_color %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save Colors</button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Images</h4>

            <div class="row g-4">
                <% const slots = [
                    { key: 'logo', label: 'Logo (navbar)', height: 80 },
                    { key: 'favicon', label: 'Favicon (browser tab icon)', height: 80 },
                    { key: 'hero_background', label: 'Hero Background (homepage banner)', height: 120 },
                    { key: 'team_photo', label: 'Team / About Photo', height: 120 },
                ]; %>
                <% slots.forEach(slot => { %>
                    <div class="col-md-6">
                        <h6 class="fw-bold"><%= slot.label %></h6>
                        <% if (images[slot.key]) { %>
                            <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:<%= slot.height %>px;">
                        <% } %>
                        <div class="d-flex gap-2">
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="d-flex gap-2 flex-grow-1">
                                <input type="file" name="file" accept="image/*" class="form-control" required>
                                <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" onsubmit="return confirm('Remove this image and go back to the default?');">
                                    <button type="submit" class="btn btn-outline-danger text-nowrap">Remove</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Admin Panel Appearance</h4>
            <p class="text-muted">This only affects the background of admin pages like this one — it's separate from the public site's colors above, so the admin tool stays legible no matter what theme the public site uses.</p>
            <form method="POST" action="/admin/design/admin-theme" class="d-flex align-items-end gap-3">
                <div>
                    <label class="form-label d-block">Admin Panel Background</label>
                    <input type="color" name="admin_bg_color" class="form-control form-control-color" value="<%= design.adminBackground %>">
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>
</div>
</body>
</html>
