<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= site.short_name %> - Site Design</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container py-5" style="max-width: 760px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold mb-0">Site Design</h1>
        <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Colors</h4>
            <p class="text-muted">Controls buttons, links, dark backgrounds (navbar, footer, hero), and the page background across the whole site.</p>
            <form method="POST" action="/admin/design/colors">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary (buttons/links)</label>
                        <input type="color" name="primary_color" class="form-control form-control-color" value="<%= colors.primary_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary Hover</label>
                        <input type="color" name="primary_dark" class="form-control form-control-color" value="<%= colors.primary_dark %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Dark (navbar/footer)</label>
                        <input type="color" name="dark_color" class="form-control form-control-color" value="<%= colors.dark_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Page Background</label>
                        <input type="color" name="light_color" class="form-control form-control-color" value="<%= colors.light_color %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save Colors</button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">Images</h4>

            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="fw-bold">Logo (navbar)</h6>
                    <% if (images.logo) { %><img src="<%= images.logo %>" class="img-fluid mb-2 rounded border" style="max-height:80px;"><% } %>
                    <form method="POST" action="/admin/design/upload/logo" enctype="multipart/form-data" class="d-flex gap-2">
                        <input type="file" name="file" accept="image/*" class="form-control" required>
                        <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                    </form>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold">Favicon (browser tab icon)</h6>
                    <% if (images.favicon) { %><img src="<%= images.favicon %>" class="img-fluid mb-2 rounded border" style="max-height:80px;"><% } %>
                    <form method="POST" action="/admin/design/upload/favicon" enctype="multipart/form-data" class="d-flex gap-2">
                        <input type="file" name="file" accept="image/*" class="form-control" required>
                        <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                    </form>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold">Hero Background (homepage banner)</h6>
                    <% if (images.hero_background) { %><img src="<%= images.hero_background %>" class="img-fluid mb-2 rounded border" style="max-height:120px;"><% } %>
                    <form method="POST" action="/admin/design/upload/hero_background" enctype="multipart/form-data" class="d-flex gap-2">
                        <input type="file" name="file" accept="image/*" class="form-control" required>
                        <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                    </form>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold">Team / About Photo</h6>
                    <% if (images.team_photo) { %><img src="<%= images.team_photo %>" class="img-fluid mb-2 rounded border" style="max-height:120px;"><% } %>
                    <form method="POST" action="/admin/design/upload/team_photo" enctype="multipart/form-data" class="d-flex gap-2">
                        <input type="file" name="file" accept="image/*" class="form-control" required>
                        <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
