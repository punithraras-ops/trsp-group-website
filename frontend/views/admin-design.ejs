<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Site Design' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>; --admin-accent: <%= design.adminColors.admin_accent %>; --admin-accent-dark: <%= design.adminColors.admin_accent_dark %>; --admin-text: <%= design.adminColors.admin_text %>; --admin-surface: <%= design.adminColors.admin_surface %>;">

<div class="admin-topbar">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <% if (design.images.logo || site.icon_path) { %>
                <img src="<%= design.images.logo || site.icon_path %>" alt="<%= site.legal_name %> logo" class="admin-logo-mark">
            <% } %>
            <h1 class="mb-0"><i class="fas fa-palette me-2" style="color: var(--admin-accent);"></i>Site Design</h1>
        </div>
        <div class="me-2"><%- include('partials/language-switcher') %></div>
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<main class="admin-page-main">
<div class="container-fluid px-4 pb-5">

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-fill-drip me-2" style="color: var(--admin-accent);"></i>Colors</h4>
            <p class="text-muted">Controls buttons, links, dark backgrounds (navbar, footer, hero), body text, headings, and the page background across the whole site.</p>
            <form method="POST" action="/admin/design/colors">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary (buttons/links)</label>
                        <input type="color" name="primary_color" class="form-control form-control-color" value="<%= colors.primary_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary Hover</label>
                        <input type="color" name="primary_dark" class="form-control form-control-color" value="<%= colors.primary_dark %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Dark (navbar/footer)</label>
                        <input type="color" name="dark_color" class="form-control form-control-color" value="<%= colors.dark_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Page Background</label>
                        <input type="color" name="light_color" class="form-control form-control-color" value="<%= colors.light_color %>">
                        <div class="form-text">Used site-wide. If you also upload a Page Background image below, the image covers this color.</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Body Text</label>
                        <input type="color" name="text_color" class="form-control form-control-color" value="<%= colors.text_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Headings</label>
                        <input type="color" name="heading_color" class="form-control form-control-color" value="<%= colors.heading_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Card Background</label>
                        <input type="color" name="card_background_color" class="form-control form-control-color" value="<%= colors.card_background_color || '#ffffff' %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save Colors</button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-images me-2" style="color: var(--admin-accent);"></i>Images</h4>

            <div class="row g-4">
                <% const slots = [
                    { key: 'logo', label: 'Logo (navbar)', height: 80 },
                    { key: 'favicon', label: 'Favicon (browser tab icon)', height: 80 },
                    { key: 'hero_background', label: 'Hero Background (homepage banner)', height: 120 },
                    { key: 'team_photo', label: 'Team / About Photo', height: 120 },
                    { key: 'page_background', label: 'Page Background (whole site, behind all pages)', height: 120 },
                    { key: 'services_background', label: 'Services Section Background', height: 120 },
                    { key: 'button_background', label: 'Button Background Texture (all primary buttons, default)', height: 80 },
                    { key: 'footer_background', label: 'Footer Background', height: 120 },
                ]; %>
                <% const navSlots = [
                    { key: 'nav_home_bg', label: 'Home Button' },
                    { key: 'nav_services_bg', label: 'Services Button' },
                    { key: 'nav_store_bg', label: 'Store Button' },
                    { key: 'nav_contact_bg', label: 'Contact Button' },
                    { key: 'nav_about_bg', label: 'About Button' },
                    { key: 'nav_language_bg', label: 'Language Button' },
                    { key: 'nav_login_bg', label: 'Login / Sign Up Button' },
                    { key: 'service_cta_bg', label: '"View Detailed Features" Buttons' },
                ]; %>
                <% slots.forEach(slot => { %>
                    <div class="col-md-6">
                        <h6 class="fw-bold"><%= slot.label %></h6>
                        <% if (images[slot.key]) { %>
                            <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:<%= slot.height %>px;">
                        <% } %>
                        <div class="d-flex gap-2">
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="d-flex gap-2 flex-grow-1 flex-wrap" data-ajax-upload>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control" required>
                                <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" data-confirm="Remove this image and go back to the default?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger text-nowrap">Remove</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1"><i class="fas fa-toolbox me-2" style="color: var(--admin-accent);"></i>Individual Navigation Buttons</h4>
            <p class="text-muted">Set a background image for one specific button. Overrides the general "Button Background Texture" above for just that button.</p>
            <div class="row g-4">
                <% navSlots.forEach(slot => { %>
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="border rounded-4 p-3 h-100">
                            <h6 class="fw-bold small mb-2"><%= slot.label %></h6>
                            <% if (images[slot.key]) { %>
                                <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:60px;">
                            <% } %>
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="mb-2" data-ajax-upload>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-primary w-100">Upload</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" data-confirm="Remove this image and go back to the default?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1"><i class="fas fa-layer-group me-2" style="color: var(--admin-accent);"></i>Frame Backgrounds</h4>
            <p class="text-muted">Set a custom background color and/or image for each individual card ("frame") on the Services and About pages. An uploaded image covers the color.</p>
            <div class="row g-4">
                <% const frameSlots = [
                    { key: 'process_card1_bg', label: 'Discover (Services page, step 1)' },
                    { key: 'process_card2_bg', label: 'Design & Build (Services page, step 2)' },
                    { key: 'process_card3_bg', label: 'Improve & Scale (Services page, step 3)' },
                    { key: 'about_mission_card_bg', label: 'Mission (About page)' },
                    { key: 'about_vision_card_bg', label: 'Vision (About page)' },
                    { key: 'about_team_card_bg', label: 'Team (About page)' },
                    { key: 'about_focus_card_bg', label: 'Focus (About page)' },
                    { key: 'home_about_mission_card_bg', label: 'Mission (Home page)' },
                    { key: 'home_about_approach_card_bg', label: 'Approach (Home page)' },
                ]; %>
                <% frameSlots.forEach(slot => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="border rounded-4 p-3 h-100">
                            <h6 class="fw-bold small mb-2"><%= slot.label %></h6>
                            <% if (images[slot.key]) { %>
                                <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:60px;">
                            <% } %>
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="mb-2" data-ajax-upload>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-primary w-100">Upload Image</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" data-confirm="Remove this image?" class="mb-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove Image</button>
                                </form>
                            <% } %>
                            <form method="POST" action="/admin/design/card-color/<%= slot.key %>" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="color" name="color" class="form-control form-control-color" value="<%= (design.cardColors && design.cardColors[slot.key]) || '#ffffff' %>">
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap flex-grow-1">Set Color</button>
                            </form>
                            <% if (design.cardColors && design.cardColors[slot.key]) { %>
                                <form method="POST" action="/admin/design/card-color/<%= slot.key %>/remove" class="mt-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Reset Color</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-toolbox me-2" style="color: var(--admin-accent);"></i>Admin Panel Appearance</h4>
            <p class="text-muted">This only affects the background of admin pages like this one — it's separate from the public site's colors above, so the admin tool stays legible no matter what theme the public site uses.</p>
            <form method="POST" action="/admin/design/admin-theme" class="d-flex align-items-end gap-3 mb-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="form-label d-block">Admin Panel Background Color</label>
                    <input type="color" name="admin_bg_color" class="form-control form-control-color" value="<%= design.adminBackground %>">
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>

            <h6 class="fw-bold mb-2">Admin Panel Colors</h6>
            <p class="text-muted small">Controls admin buttons, active tabs, links, body text, and card backgrounds across every admin page — same idea as the public site's Colors section above, kept separate so the admin tool stays legible no matter what theme the public site uses.</p>
            <form method="POST" action="/admin/design/admin-colors" class="mb-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Accent (buttons/links)</label>
                        <input type="color" name="admin_accent" class="form-control form-control-color" value="<%= design.adminColors.admin_accent %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Accent Hover</label>
                        <input type="color" name="admin_accent_dark" class="form-control form-control-color" value="<%= design.adminColors.admin_accent_dark %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Body Text</label>
                        <input type="color" name="admin_text" class="form-control form-control-color" value="<%= design.adminColors.admin_text %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Card/Surface Background</label>
                        <input type="color" name="admin_surface" class="form-control form-control-color" value="<%= design.adminColors.admin_surface %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save Admin Colors</button>
            </form>

            <h6 class="fw-bold mb-2">Admin Panel Background Image</h6>
            <p class="text-muted small">Optional — overlays on top of the color above across every admin page.</p>
            <% if (images.admin_page_background) { %>
                <img src="<%= images.admin_page_background %>" class="img-fluid mb-2 rounded border d-block" style="max-height:120px;">
            <% } %>
            <div class="d-flex gap-2">
                <form method="POST" action="/admin/design/upload/admin_page_background" enctype="multipart/form-data" class="d-flex gap-2 flex-grow-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="file" name="file" accept="image/*" class="form-control" required>
                    <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                </form>
                <% if (images.admin_page_background) { %>
                    <form method="POST" action="/admin/design/remove/admin_page_background" data-confirm="Remove this image and go back to the plain color?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-danger text-nowrap">Remove</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1"><i class="fas fa-toolbox me-2" style="color: var(--admin-accent);"></i>Admin Portal Buttons</h4>
            <p class="text-muted">Set a custom color or background image for each button in the admin dashboard's top bar (this page only affects the admin portal, never the public site).</p>
            <div class="row g-4">
                <% const adminBtnSlots = [
                    { key: 'admin_btn_tickets', label: 'Tickets' },
                    { key: 'admin_btn_siteinfo', label: 'Site Info' },
                    { key: 'admin_btn_sitedesign', label: 'Site Design' },
                    { key: 'admin_btn_legal', label: 'Legal' },
                    { key: 'admin_btn_coupons', label: 'Coupons' },
                    { key: 'admin_btn_auditlog', label: 'Audit Log' },
                    { key: 'admin_btn_security', label: 'Security' },
                    { key: 'admin_btn_logout', label: 'Logout' },
                ]; %>
                <% adminBtnSlots.forEach(slot => { %>
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="border rounded-4 p-3 h-100">
                            <h6 class="fw-bold small mb-2"><%= slot.label %></h6>
                            <% if (images[slot.key]) { %>
                                <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:60px;">
                            <% } %>
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="mb-2" data-ajax-upload>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-primary w-100">Upload Image</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" data-confirm="Remove this image?" class="mb-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove Image</button>
                                </form>
                            <% } %>
                            <form method="POST" action="/admin/design/admin-button-color/<%= slot.key %>" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="color" name="color" class="form-control form-control-color" value="<%= (design.adminButtonColors && design.adminButtonColors[slot.key]) || '#4f46e5' %>">
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap flex-grow-1">Set Color</button>
                            </form>
                            <% if (design.adminButtonColors && design.adminButtonColors[slot.key]) { %>
                                <form method="POST" action="/admin/design/admin-button-color/<%= slot.key %>/remove" class="mt-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Reset Color</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1"><i class="fas fa-chart-simple me-2" style="color: var(--admin-accent);"></i>Admin Dashboard Cards</h4>
            <p class="text-muted">Set a custom background color and/or image for each of the summary cards at the top of the admin dashboard (this only affects the admin portal, never the public site).</p>
            <div class="row g-4">
                <% const adminCardSlots = [
                    { key: 'admin_stat_submissions_bg', label: 'Contact Submissions' },
                    { key: 'admin_stat_users_bg', label: 'Registered Users' },
                    { key: 'admin_stat_orders_bg', label: 'Total Orders' },
                    { key: 'admin_stat_pending_bg', label: 'Pending Approvals' },
                    { key: 'admin_stat_upi_bg', label: 'Pending UPI Confirmations' },
                    { key: 'admin_stat_revenue_bg', label: 'Revenue (Paid)' },
                ]; %>
                <% adminCardSlots.forEach(slot => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="border rounded-4 p-3 h-100">
                            <h6 class="fw-bold small mb-2"><%= slot.label %></h6>
                            <% if (images[slot.key]) { %>
                                <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:60px;">
                            <% } %>
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="mb-2" data-ajax-upload>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-primary w-100">Upload Image</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" data-confirm="Remove this image?" class="mb-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove Image</button>
                                </form>
                            <% } %>
                            <form method="POST" action="/admin/design/card-color/<%= slot.key %>" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="color" name="color" class="form-control form-control-color" value="<%= (design.cardColors && design.cardColors[slot.key]) || '#ffffff' %>">
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap flex-grow-1">Set Color</button>
                            </form>
                            <% if (design.cardColors && design.cardColors[slot.key]) { %>
                                <form method="POST" action="/admin/design/card-color/<%= slot.key %>/remove" class="mt-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Reset Color</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<%- include('partials/confirm-modal') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/confirm-modal.js"></script>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
<script src="/js/admin-upload.js"></script>
</body>
</html>
