<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Site Design' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>;">

<div class="admin-topbar">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3" style="max-width: 1140px;">
        <h1><i class="fas fa-palette me-2" style="color: var(--admin-accent);"></i>Site Design</h1>
        <div class="me-2"><%- include('partials/language-switcher') %></div>
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<main class="admin-page-main">
<div class="container pb-5" style="max-width: 1140px;">

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-fill-drip me-2" style="color: var(--admin-accent);"></i>Colors</h4>
            <p class="text-muted">Controls buttons, links, dark backgrounds (navbar, footer, hero), body text, headings, and the page background across the whole site.</p>
            <form method="POST" action="/admin/design/colors">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary (buttons/links)</label>
                        <input type="color" name="primary_color" class="form-control form-control-color" value="<%= colors.primary_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Primary Hover</label>
                        <input type="color" name="primary_dark" class="form-control form-control-color" value="<%= colors.primary_dark %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Dark (navbar/footer)</label>
                        <input type="color" name="dark_color" class="form-control form-control-color" value="<%= colors.dark_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Page Background</label>
                        <input type="color" name="light_color" class="form-control form-control-color" value="<%= colors.light_color %>">
                        <div class="form-text">Used site-wide. If you also upload a Page Background image below, the image covers this color.</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Body Text</label>
                        <input type="color" name="text_color" class="form-control form-control-color" value="<%= colors.text_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Headings</label>
                        <input type="color" name="heading_color" class="form-control form-control-color" value="<%= colors.heading_color %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label d-block">Card Background</label>
                        <input type="color" name="card_background_color" class="form-control form-control-color" value="<%= colors.card_background_color || '#ffffff' %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save Colors</button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-images me-2" style="color: var(--admin-accent);"></i>Images</h4>

            <div class="row g-4">
                <% const slots = [
                    { key: 'logo', label: 'Logo (navbar)', height: 80 },
                    { key: 'favicon', label: 'Favicon (browser tab icon)', height: 80 },
                    { key: 'hero_background', label: 'Hero Background (homepage banner)', height: 120 },
                    { key: 'team_photo', label: 'Team / About Photo', height: 120 },
                    { key: 'page_background', label: 'Page Background (whole site, behind all pages)', height: 120 },
                    { key: 'services_background', label: 'Services Section Background', height: 120 },
                    { key: 'button_background', label: 'Button Background Texture (all primary buttons, default)', height: 80 },
                ]; %>
                <% const navSlots = [
                    { key: 'nav_home_bg', label: 'Home Button' },
                    { key: 'nav_services_bg', label: 'Services Button' },
                    { key: 'nav_store_bg', label: 'Store Button' },
                    { key: 'nav_contact_bg', label: 'Contact Button' },
                    { key: 'nav_about_bg', label: 'About Button' },
                    { key: 'nav_language_bg', label: 'Language Button' },
                    { key: 'nav_login_bg', label: 'Login / Sign Up Button' },
                    { key: 'service_cta_bg', label: '"View Detailed Features" Buttons' },
                ]; %>
                <% slots.forEach(slot => { %>
                    <div class="col-md-6">
                        <h6 class="fw-bold"><%= slot.label %></h6>
                        <% if (images[slot.key]) { %>
                            <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:<%= slot.height %>px;">
                        <% } %>
                        <div class="d-flex gap-2">
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="d-flex gap-2 flex-grow-1">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control" required>
                                <button type="submit" class="btn btn-primary text-nowrap">Upload</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" onsubmit="return confirm('Remove this image and go back to the default?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger text-nowrap">Remove</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1"><i class="fas fa-toolbox me-2" style="color: var(--admin-accent);"></i>Individual Navigation Buttons</h4>
            <p class="text-muted">Set a background image for one specific button. Overrides the general "Button Background Texture" above for just that button.</p>
            <div class="row g-4">
                <% navSlots.forEach(slot => { %>
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="border rounded-4 p-3 h-100">
                            <h6 class="fw-bold small mb-2"><%= slot.label %></h6>
                            <% if (images[slot.key]) { %>
                                <img src="<%= images[slot.key] %>" class="img-fluid mb-2 rounded border d-block" style="max-height:60px;">
                            <% } %>
                            <form method="POST" action="/admin/design/upload/<%= slot.key %>" enctype="multipart/form-data" class="mb-2">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm mb-2" required>
                                <button type="submit" class="btn btn-sm btn-primary w-100">Upload</button>
                            </form>
                            <% if (images[slot.key]) { %>
                                <form method="POST" action="/admin/design/remove/<%= slot.key %>" onsubmit="return confirm('Remove this image and go back to the default?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remove</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-toolbox me-2" style="color: var(--admin-accent);"></i>Admin Panel Appearance</h4>
            <p class="text-muted">This only affects the background of admin pages like this one — it's separate from the public site's colors above, so the admin tool stays legible no matter what theme the public site uses.</p>
            <form method="POST" action="/admin/design/admin-theme" class="d-flex align-items-end gap-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="form-label d-block">Admin Panel Background</label>
                    <input type="color" name="admin_bg_color" class="form-control form-control-color" value="<%= design.adminBackground %>">
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
