<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Forgot Password' }) %>
<body class="admin-auth-page d-flex align-items-center justify-content-center" style="min-height: 100vh;">
<div class="card border-0 shadow-lg rounded-4" style="width: 100%; max-width: 420px;">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <i class="fas fa-key" style="font-size: 2rem; color: #4f46e5;"></i>
        </div>
        <h3 class="fw-bold text-center mb-2">Reset Admin Password</h3>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% if (!totpAvailable) { %>
            <p class="text-muted text-center">Two-factor authentication isn't enabled on this account, so there's no self-service way to recover the password. Ask whoever manages the server to reset it directly.</p>
            <div class="text-center mt-3"><a href="/admin/login">Back to login</a></div>
        <% } else { %>
            <p class="text-muted text-center mb-4">Enter the current 6-digit code from your authenticator app to verify it's you, then you'll be able to set a new password.</p>
            <form method="POST" action="/admin/forgot-password">
                <div class="mb-4">
                    <input type="text" name="code" class="form-control form-control-lg text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Verify Code</button>
            </form>
            <div class="text-center"><a href="/admin/login">Back to login</a></div>
        <% } %>
    </div>
</div>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
