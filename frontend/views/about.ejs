<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding section-soft page-offset">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="section-eyebrow">About <%= site.short_name %></span>
                <h1 class="display-4 fw-bold mb-4"><%= site.about_heading %></h1>
                <p class="lead"><%= site.short_name %> is a technology-focused organization based in <strong><%= site.location %></strong>. We help teams plan, build, and improve digital systems with dependable execution and a strong product mindset.</p>
                <p><%= site.about_paragraph2 %></p>

                <div class="about-mini-grid">
                    <div class="about-mini-card">
                        <h3><%= site.about_mission_title %></h3>
                        <p><%= site.about_mission_text %></p>
                    </div>
                    <div class="about-mini-card">
                        <h3><%= site.about_vision_title %></h3>
                        <p><%= site.about_vision_text %></p>
                    </div>
                    <div class="about-mini-card">
                        <h3><%= site.about_team_title %></h3>
                        <p><%= site.about_team_text %></p>
                    </div>
                    <div class="about-mini-card">
                        <h3><%= site.about_focus_title %></h3>
                        <p><%= site.about_focus_text %></p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <div class="about-visual-shell">
                    <img src="<%= design.images.team_photo || '/img/placeholder-team.svg' %>" alt="Technical of RSP Groups Team" class="img-fluid rounded shadow-lg">
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
