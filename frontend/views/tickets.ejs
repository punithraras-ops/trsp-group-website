<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding bg-light page-offset">
    <div class="container-fluid px-4 px-xl-5">
        <h1 class="display-5 fw-bold mb-4">My Tickets</h1>
        <p class="lead">Raise a custom product requirement and track it here until it's delivered.</p>

        <% if (ticketCreated) { %>
            <div class="alert alert-success">Your ticket has been submitted. Our team will contact you within 24 hours &mdash; you can track progress here.</div>
        <% } %>
        <% if (rated) { %>
            <div class="alert alert-success">Thanks for your rating!</div>
        <% } %>
        <% if (unreadCount > 0) { %>
            <div class="toast-notification toast-warning" data-ticket-unread-toast role="status">
                <i class="fas fa-comments me-2"></i>You have new repl<%= unreadCount > 1 ? 'ies' : 'y' %> on <%= unreadCount %> ticket<%= unreadCount > 1 ? 's' : '' %>.
            </div>
        <% } %>

        <div class="row mb-5">
            <div class="col-xl-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">Raise a New Ticket</h4>
                        <form method="POST" action="/tickets" enctype="multipart/form-data" data-ajax-upload>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label class="form-label">Title</label>
                                <input type="text" name="title" class="form-control" placeholder="e.g. Custom inventory management tool" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Describe your requirement</label>
                                <textarea name="description" class="form-control" rows="4" placeholder="Tell us what you need built, any specific features, deadlines, or references." required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Which service is this about?</label>
                                <select name="service_id" class="form-select" required>
                                    <option value="" disabled selected>Select a service</option>
                                    <% services.forEach(s => { %>
                                        <option value="<%= s.id %>"><%= s.title %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Attach reference files (optional)</label>
                                <input type="file" name="attachments" multiple class="form-control">
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Ticket</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <h3 class="fw-bold mb-3">Ticket History</h3>
        <% if (tickets.length === 0) { %>
            <p class="text-muted">You haven't raised any tickets yet.</p>
        <% } else { %>
            <div class="row row-cols-1 row-cols-xl-2 g-3">
                <% tickets.forEach(t => { %>
                    <div class="col">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                <div>
                                    <h5 class="fw-bold mb-1"><%= t.title %></h5>
                                    <span class="text-muted small"><%= new Date(t.created_at).toLocaleString('en-IN') %></span>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-<%= t.status === 'fulfilled' ? 'success' : (t.status === 'closed' ? 'secondary' : (t.status === 'in_progress' ? 'info' : 'warning text-dark')) %>"><%= t.status.replace(/_/g, ' ') %></span>
                                    <span class="badge bg-<%= t.delivery_status === 'delivered' ? 'success' : 'secondary' %>"><%= t.delivery_status.replace(/_/g, ' ') %></span>
                                    <% if (t.price_paise) { %>
                                        <span class="badge bg-<%= t.payment_status === 'paid' ? 'success' : (t.payment_status === 'awaiting_confirmation' ? 'warning text-dark' : 'danger') %>"><%= t.payment_status === 'paid' ? 'Paid' : (t.payment_status === 'awaiting_confirmation' ? 'Awaiting Confirmation' : 'Unpaid') %></span>
                                    <% } %>
                                </div>
                            </div>
                            <p class="text-muted mb-3"><%= t.description %></p>

                            <% if (t.attachments && t.attachments.length > 0) { %>
                                <div class="mb-3">
                                    <% t.attachments.forEach(f => { %>
                                        <span class="badge bg-light text-dark border me-1 mb-1"><i class="fas fa-paperclip me-1"></i><%= f.filename %></span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <% if (t.price_paise) { %>
                                <p class="fw-bold mb-2">Price: &#8377;<%= (t.price_paise / 100).toLocaleString('en-IN') %></p>
                            <% } %>
                            <% if (t.admin_notes) { %>
                                <div class="alert alert-info py-2 mb-3"><strong>Note from us:</strong> <%= t.admin_notes %></div>
                            <% } %>

                            <div class="alert d-none py-2" data-ticket-pay-status="<%= t.id %>" role="status"></div>

                            <div class="d-flex gap-2 flex-wrap align-items-center">
                                <% if (t.price_paise && t.payment_status === 'unpaid' && razorpayConfigured) { %>
                                    <button type="button" class="btn btn-sm btn-primary" data-pay-ticket="<%= t.id %>">Pay Now</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-pay-ticket-upi="<%= t.id %>"><i class="fas fa-qrcode me-1"></i>Pay with UPI</button>
                                <% } %>
                                <% if (t.price_paise && t.payment_status === 'unpaid') { %>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-pay-ticket-manual-upi="<%= t.id %>"><i class="fas fa-mobile-screen-button me-1"></i>Pay via UPI QR (Manual)</button>
                                <% } %>
                                <% if (t.price_paise) { %>
                                    <a href="/tickets/<%= t.id %>/invoice" class="btn btn-sm btn-outline-secondary"><i class="fas fa-file-invoice me-1"></i>Invoice</a>
                                <% } %>
                                <% if (t.deliverable_files && t.deliverable_files.length > 0) { %>
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-success dropdown-toggle files-dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="fas fa-download me-1"></i>Files (<%= t.deliverable_files.length %>)</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <% t.deliverable_files.forEach(f => { %>
                                                <li><a class="dropdown-item" href="/tickets/<%= t.id %>/download/<%= f.id %>"><i class="fas fa-file-arrow-down me-2"></i><%= f.filename %></a></li>
                                            <% }) %>
                                        </ul>
                                    </div>
                                <% } %>
                                <button type="button" class="btn btn-sm btn-outline-dark" data-open-chat="<%= t.id %>" data-ticket-title="<%= t.title %>" data-ticket-status="<%= t.status %>">
                                    <i class="fas fa-comments me-1"></i>Conversation
                                </button>
                            </div>

                            <div id="manualUpiPanel-<%= t.id %>" class="d-none mt-3 text-center border rounded-4 p-3"></div>

                            <% if (t.delivery_status === 'delivered') { %>
                                <div class="mt-3 pt-3 border-top">
                                    <% if (t.customer_rating) { %>
                                        <p class="mb-0">
                                            <strong>Your rating:</strong>
                                            <% for (let i = 1; i <= 5; i++) { %><i class="fa-star <%= i <= t.customer_rating ? 'fas text-warning' : 'far text-muted' %>"></i><% } %>
                                            <% if (t.customer_rating_comment) { %><span class="text-muted"> &mdash; "<%= t.customer_rating_comment %>"</span><% } %>
                                        </p>
                                    <% } else { %>
                                        <h6 class="fw-bold mb-2">Rate this project</h6>
                                        <form method="POST" action="/tickets/<%= t.id %>/rate" class="rate-ticket-form" data-ticket-id="<%= t.id %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="rating" value="5" class="rating-input">
                                            <div class="mb-2 rating-stars">
                                                <% for (let i = 1; i <= 5; i++) { %><i class="far fa-star fs-5 text-warning me-1" data-star="<%= i %>" style="cursor:pointer;"></i><% } %>
                                            </div>
                                            <textarea name="comment" class="form-control mb-2" rows="2" placeholder="Optional comment"></textarea>
                                            <button type="submit" class="btn btn-sm btn-primary">Submit Rating</button>
                                        </form>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<div class="modal fade" id="ticketChatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="ticketChatModalTitle">Conversation</h5>
                <button type="button" class="btn btn-sm btn-outline-danger me-2" id="ticketChatClearBtn"><i class="fas fa-trash me-1"></i>Clear Chat</button>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <div id="ticketChatMessages" class="d-flex flex-column gap-2 mb-3" style="max-height: 50vh; overflow-y: auto;"><p class="text-muted">Loading...</p></div>
                <form id="ticketChatForm" class="d-flex gap-2">
                    <input type="text" id="ticketChatInput" class="form-control" placeholder="Type a message..." required>
                    <button type="submit" class="btn btn-primary text-nowrap">Send</button>
                </form>
                <div id="ticketChatStatus" class="small mt-2"></div>
            </div>
        </div>
    </div>
</div>

<% if (razorpayConfigured) { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<% } %>
<script src="/js/admin-upload.js"></script>
<script src="/js/tickets.js"></script>

<%- include('partials/footer') %>
