<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="hero text-center text-white d-flex align-items-center services-hero">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9" data-aos="fade-up">
                <span class="hero-kicker"><%= site.services_hero_kicker %></span>
                <h1 class="hero-title display-3 fw-bold mb-4"><%= site.services_hero_title %></h1>
                <p class="hero-description lead mb-0"><%= site.services_hero_description %></p>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light" id="services">
    <div class="container">
        <div class="section-heading text-center mx-auto" data-aos="fade-up">
            <span class="section-eyebrow"><%= site.services_offer_kicker %></span>
            <h2 class="display-4 fw-bold mb-3"><%= site.services_offer_heading %></h2>
            <p class="section-description"><%= site.services_offer_description %></p>
        </div>

        <% if (!dbConfigured) { %>
            <div class="alert alert-info text-center">Services are being configured. Please check back soon.</div>
        <% } else if (services.length === 0) { %>
            <div class="alert alert-info text-center">No services published yet.</div>
        <% } else { %>
        <div class="row g-4 justify-content-center">
            <% services.forEach((service, index) => { %>
                <div class="col-xl-3 col-lg-6 col-md-6" data-aos="zoom-in" data-aos-delay="<%= index * 100 %>">
                    <article class="card service-card h-100 border-0 shadow-lg" <% if (service.background_color || service.background_image) { %>style="<%- include('partials/frame-bg-style', { color: service.background_color, image: service.background_image, overlay: 'light' }) %>"<% } %>>
                        <div class="card-body d-flex flex-column">
                            <div class="service-card-header">
                                <span class="service-icon-wrap">
                                    <i class="<%= service.icon %>" aria-hidden="true"></i>
                                </span>
                            </div>

                            <div class="service-card-content mb-4">
                                <h3 class="service-card-title"><%= service.title %></h3>
                                <p class="card-text text-muted mb-0"><%= service.summary %></p>
                            </div>

                            <a href="/services/<%= service.slug %>" class="btn btn-primary service-card-button mt-auto">
                                <%= service.cta_label %> <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</section>

<section class="section-padding section-soft">
    <div class="container">
        <div class="section-heading text-center mx-auto" data-aos="fade-up">
            <span class="section-eyebrow"><%= site.services_process_kicker %></span>
            <h2 class="display-5 fw-bold mb-3"><%= site.services_process_heading %></h2>
            <p class="section-description"><%= site.services_process_description %></p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6" data-aos="fade-up">
                <div class="process-card h-100" <% if (design.cardColors.process_card1_bg || design.images.process_card1_bg) { %>style="<%- include('partials/frame-bg-style', { color: design.cardColors.process_card1_bg, image: design.images.process_card1_bg, overlay: 'light' }) %>"<% } %>>
                    <span class="process-number">01</span>
                    <h3><%= site.services_process_card1_title %></h3>
                    <p><%= site.services_process_card1_text %></p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="process-card h-100" <% if (design.cardColors.process_card2_bg || design.images.process_card2_bg) { %>style="<%- include('partials/frame-bg-style', { color: design.cardColors.process_card2_bg, image: design.images.process_card2_bg, overlay: 'light' }) %>"<% } %>>
                    <span class="process-number">02</span>
                    <h3><%= site.services_process_card2_title %></h3>
                    <p><%= site.services_process_card2_text %></p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="process-card h-100" <% if (design.cardColors.process_card3_bg || design.images.process_card3_bg) { %>style="<%- include('partials/frame-bg-style', { color: design.cardColors.process_card3_bg, image: design.images.process_card3_bg, overlay: 'light' }) %>"<% } %>>
                    <span class="process-number">03</span>
                    <h3><%= site.services_process_card3_title %></h3>
                    <p><%= site.services_process_card3_text %></p>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
