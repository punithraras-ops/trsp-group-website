<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding bg-light page-offset">
    <div class="container">
        <h1 class="display-5 fw-bold mb-4">My Account</h1>
        <p class="lead">Signed in as <strong><%= user.name %></strong> (<%= user.email %>)</p>

        <% if (typeof verified !== 'undefined' && verified) { %>
            <div class="alert alert-success">Your email address has been verified. Thank you!</div>
        <% } %>
        <% if (typeof resent !== 'undefined' && resent) { %>
            <div class="alert alert-info">Verification email sent. Please check your inbox.</div>
        <% } %>
        <% if (!user.email_verified) { %>
            <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="fas fa-triangle-exclamation me-2"></i>Your email address is not verified yet.</span>
                <a href="/resend-verification" class="btn btn-sm btn-outline-dark">Resend verification email</a>
            </div>
        <% } %>

        <div class="alert d-none" data-retry-status role="status"></div>

        <h3 class="fw-bold mt-5 mb-3">My Orders</h3>
        <% if (orders.length === 0) { %>
            <p class="text-muted">You have not placed any orders yet. <a href="/store">Browse the store</a>.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Delivery</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td class="text-nowrap"><%= new Date(order.created_at).toLocaleString('en-IN') %></td>
                                <td><%= order.display_title %></td>
                                <td>&#8377;<%= (order.amount_paise / 100).toLocaleString('en-IN') %></td>
                                <td>
                                    <span class="badge bg-<%= order.status === 'paid' ? 'success' : (order.status === 'failed' || order.status === 'rejected' ? 'danger' : (order.status === 'pending_approval' ? 'warning text-dark' : 'secondary')) %>"><%= order.status.replace(/_/g, ' ') %></span>
                                </td>
                                <td>
                                    <% if (order.status === 'paid') { %>
                                        <span class="badge bg-<%= order.delivery_status === 'delivered' ? 'success' : (order.delivery_status === 'cancelled' ? 'danger' : 'info') %>"><%= order.delivery_status || 'processing' %></span>
                                    <% } else { %>
                                        <span class="text-muted">&mdash;</span>
                                    <% } %>
                                </td>
                                <td class="text-nowrap">
                                    <% if (order.status === 'approved_awaiting_payment') { %>
                                        <a href="/checkout?product=<%= order.product_id %>" class="btn btn-sm btn-primary">Pay Now</a>
                                    <% } %>
                                    <% if ((order.status === 'created' || order.status === 'failed') && razorpayConfigured) { %>
                                        <button type="button" class="btn btn-sm btn-primary" data-retry-payment="<%= order.id %>">
                                            <i class="fas fa-arrows-rotate me-1"></i><%= order.status === 'failed' ? 'Retry Payment' : 'Complete Payment' %>
                                        </button>
                                    <% } %>
                                    <% if (order.status === 'paid') { %>
                                        <a href="/account/orders/<%= order.id %>/invoice" class="btn btn-sm btn-outline-secondary"><i class="fas fa-file-invoice me-1"></i>Invoice</a>
                                    <% } %>
                                    <% if (order.downloadableFiles && order.downloadableFiles.length > 0) { %>
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="fas fa-download me-1"></i>Files (<%= order.downloadableFiles.length %>)</button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <% order.downloadableFiles.forEach(f => { %>
                                                    <li><a class="dropdown-item" href="/account/orders/<%= order.id %>/download/<%= f.id %>"><i class="fas fa-file-arrow-down me-2"></i><%= f.filename %></a></li>
                                                <% }) %>
                                            </ul>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <h3 class="fw-bold mt-5 mb-3">Account Settings</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Profile</h5>
                        <% if (typeof profileUpdated !== 'undefined' && profileUpdated) { %>
                            <div class="alert alert-success py-2">Profile updated.</div>
                        <% } %>
                        <form method="POST" action="/account/update-profile">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="<%= user.email %>" disabled>
                                <div class="form-text">Contact us to change your email address.</div>
                            </div>
                            <button type="submit" class="btn btn-primary">Save Profile</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Password</h5>
                        <% if (typeof pwSuccess !== 'undefined' && pwSuccess) { %>
                            <div class="alert alert-success py-2">Password updated.</div>
                        <% } %>
                        <% if (typeof pwError !== 'undefined' && pwError) { %>
                            <div class="alert alert-danger py-2"><%= pwError %></div>
                        <% } %>
                        <% if (user.has_password) { %>
                            <form method="POST" action="/account/change-password">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-3">
                                    <label class="form-label">Current Password</label>
                                    <input type="password" name="current_password" class="form-control" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">New Password</label>
                                    <input type="password" name="new_password" class="form-control" minlength="8" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirm New Password</label>
                                    <input type="password" name="confirm_password" class="form-control" minlength="8" required>
                                </div>
                                <button type="submit" class="btn btn-primary">Update Password</button>
                            </form>
                        <% } else { %>
                            <p class="text-muted mb-0">You signed in with Google/GitHub, so there's no password to manage here.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (razorpayConfigured) { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<% } %>
<script src="/js/account.js"></script>

<%- include('partials/footer') %>
