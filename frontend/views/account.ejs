<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding bg-light page-offset">
    <div class="container">
        <h1 class="display-5 fw-bold mb-4">My Account</h1>
        <p class="lead">Signed in as <strong><%= user.name %></strong> (<%= user.email %>)</p>

        <% if (typeof verified !== 'undefined' && verified) { %>
            <div class="alert alert-success">Your email address has been verified. Thank you!</div>
        <% } %>
        <% if (typeof resent !== 'undefined' && resent) { %>
            <div class="alert alert-info">Verification email sent. Please check your inbox.</div>
        <% } %>
        <% if (!user.email_verified) { %>
            <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="fas fa-triangle-exclamation me-2"></i>Your email address is not verified yet.</span>
                <a href="/resend-verification" class="btn btn-sm btn-outline-dark">Resend verification email</a>
            </div>
        <% } %>

        <div class="alert d-none" data-retry-status role="status"></div>

        <% if (typeof ordersCleared !== 'undefined' && ordersCleared) { %>
            <div class="toast-notification" data-auto-toast><i class="fas fa-circle-check me-2"></i>Abandoned orders cleared.</div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-5 mb-3">
            <h3 class="fw-bold mb-0">My Orders</h3>
            <% if (orders.some(o => ['created','failed','rejected'].includes(o.status))) { %>
                <form method="POST" action="/account/orders/clear" onsubmit="return confirm('Remove all abandoned/failed/rejected orders from your history? Paid orders are never affected.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-broom me-1"></i>Clear My Orders</button>
                </form>
            <% } %>
        </div>
        <% if (orders.length === 0) { %>
            <p class="text-muted">You have not placed any orders yet. <a href="/store">Browse the store</a>.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Delivery</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td class="text-nowrap"><%= new Date(order.created_at).toLocaleString('en-IN') %></td>
                                <td><%= order.display_title %></td>
                                <td>&#8377;<%= (order.amount_paise / 100).toLocaleString('en-IN') %></td>
                                <td>
                                    <span class="badge bg-<%= order.status === 'paid' ? 'success' : (order.status === 'failed' || order.status === 'rejected' ? 'danger' : ((order.status === 'pending_approval' || order.status === 'awaiting_upi_confirmation') ? 'warning text-dark' : 'secondary')) %>"><%= order.status.replace(/_/g, ' ') %></span>
                                </td>
                                <td>
                                    <% if (order.status === 'paid') { %>
                                        <span class="badge bg-<%= order.delivery_status === 'delivered' ? 'success' : (order.delivery_status === 'cancelled' ? 'danger' : 'info') %>"><%= order.delivery_status || 'processing' %></span>
                                    <% } else { %>
                                        <span class="text-muted">&mdash;</span>
                                    <% } %>
                                </td>
                                <td class="text-nowrap">
                                    <% if (order.status === 'approved_awaiting_payment') { %>
                                        <a href="/checkout?product=<%= order.product_id %>" class="btn btn-sm btn-primary">Pay Now</a>
                                    <% } %>
                                    <% if ((order.status === 'created' || order.status === 'failed') && razorpayConfigured) { %>
                                        <button type="button" class="btn btn-sm btn-primary" data-retry-payment="<%= order.id %>">
                                            <i class="fas fa-arrows-rotate me-1"></i><%= order.status === 'failed' ? 'Retry Payment' : 'Complete Payment' %>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-retry-payment-upi="<%= order.id %>" title="Pay with UPI">
                                            <i class="fas fa-qrcode"></i>
                                        </button>
                                    <% } %>
                                    <% if (order.status === 'awaiting_upi_confirmation') { %>
                                        <% if (order.utr_reference) { %>
                                            <span class="small text-muted">UTR submitted &mdash; awaiting confirmation</span>
                                        <% } else { %>
                                            <div class="input-group input-group-sm" style="max-width: 260px;" data-utr-submit-form data-order-id="<%= order.id %>">
                                                <input type="text" class="form-control" placeholder="Enter UPI UTR / transaction ID" data-utr-input>
                                                <button class="btn btn-outline-primary" type="button" data-utr-submit-btn>Submit</button>
                                            </div>
                                            <div class="small mt-1" data-utr-submit-status></div>
                                        <% } %>
                                    <% } %>
                                    <% if (order.status === 'paid') { %>
                                        <a href="/account/orders/<%= order.id %>/invoice" class="btn btn-sm btn-outline-secondary"><i class="fas fa-file-invoice me-1"></i>Invoice</a>
                                    <% } %>
                                    <% if (order.status === 'paid' && order.product_id) { %>
                                        <a href="/store?review=<%= order.product_id %>&title=<%= encodeURIComponent(order.display_title) %>" class="btn btn-sm btn-outline-warning"><i class="fas fa-star me-1"></i>Review</a>
                                    <% } %>
                                    <% if (order.downloadableFiles && order.downloadableFiles.length > 0) { %>
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-success dropdown-toggle files-dropdown-toggle" type="button" data-bs-toggle="dropdown"><i class="fas fa-download me-1"></i>Files (<%= order.downloadableFiles.length %>)</button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <% order.downloadableFiles.forEach(f => { %>
                                                    <li><a class="dropdown-item" href="/account/orders/<%= order.id %>/download/<%= f.id %>"><i class="fas fa-file-arrow-down me-2"></i><%= f.filename %></a></li>
                                                <% }) %>
                                            </ul>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <h3 class="fw-bold mt-5 mb-3">Account Settings</h3>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Profile</h5>
                        <% if (typeof profileUpdated !== 'undefined' && profileUpdated) { %>
                            <div class="alert alert-success py-2">Profile updated.</div>
                        <% } %>
                        <form method="POST" action="/account/update-profile">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="<%= user.email %>" disabled>
                                <div class="form-text">Contact us to change your email address.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" value="<%= user.phone || '' %>" placeholder="Add your phone number">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Address</label>
                                <textarea name="address" class="form-control" rows="2" placeholder="Add your address"><%= user.address || '' %></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Save Profile</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Password</h5>
                        <% if (typeof pwSuccess !== 'undefined' && pwSuccess) { %>
                            <div class="alert alert-success py-2">Password updated.</div>
                        <% } %>
                        <% if (typeof pwError !== 'undefined' && pwError) { %>
                            <div class="alert alert-danger py-2"><%= pwError %></div>
                        <% } %>
                        <% if (user.has_password) { %>
                            <form method="POST" action="/account/change-password">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-3">
                                    <label class="form-label">Current Password</label>
                                    <input type="password" name="current_password" class="form-control" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">New Password</label>
                                    <input type="password" name="new_password" class="form-control" minlength="8" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Confirm New Password</label>
                                    <input type="password" name="confirm_password" class="form-control" minlength="8" required>
                                </div>
                                <button type="submit" class="btn btn-primary">Update Password</button>
                            </form>
                        <% } else { %>
                            <p class="text-muted mb-0">You signed in with Google/GitHub, so there's no password to manage here.</p>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Two-Factor Authentication</h5>
                        <% if (typeof totpMessage !== 'undefined' && totpMessage) { %>
                            <div class="alert alert-success py-2"><%= totpMessage %></div>
                        <% } %>
                        <% if (typeof totpError !== 'undefined' && totpError) { %>
                            <div class="alert alert-danger py-2"><%= totpError %></div>
                        <% } %>

                        <% if (totpEnabled) { %>
                            <p class="text-success fw-bold mb-2"><i class="fas fa-check me-1"></i>Enabled</p>
                            <p class="text-muted small">Logging in now requires a code from your authenticator app.</p>
                            <form method="POST" action="/account/security/disable">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-3">
                                    <label class="form-label">Enter current code to disable</label>
                                    <input type="text" name="code" class="form-control text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required>
                                </div>
                                <button type="submit" class="btn btn-outline-danger btn-sm">Disable 2FA</button>
                            </form>
                        <% } else if (typeof enrollment !== 'undefined' && enrollment) { %>
                            <p class="small mb-2">1. Scan with Google Authenticator, Authy, or any TOTP app:</p>
                            <div class="text-center mb-2">
                                <img src="<%= enrollment.qrDataUrl %>" alt="2FA QR code" style="width: 160px; height: 160px;">
                            </div>
                            <p class="small">Or enter manually: <code><%= enrollment.secret %></code></p>
                            <form method="POST" action="/account/security/confirm-enrollment">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-2">
                                    <label class="form-label small">2. Enter the 6-digit code to confirm:</label>
                                    <input type="text" name="code" class="form-control text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm w-100">Confirm &amp; Enable</button>
                            </form>
                        <% } else { %>
                            <p class="text-muted small">Add an authenticator app for a second layer of login security.</p>
                            <form method="POST" action="/account/security/start-enrollment">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-primary btn-sm">Enable 2FA</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (razorpayConfigured) { %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<% } %>
<script src="/js/account.js"></script>

<%- include('partials/footer') %>
