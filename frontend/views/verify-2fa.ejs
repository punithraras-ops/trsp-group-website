<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding bg-light page-offset">
    <div class="container" style="max-width: 480px;">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5 text-center">
                <i class="fas fa-mobile-screen-button mb-3" style="font-size: 2rem; color: var(--primary-color);"></i>
                <h1 class="h3 fw-bold mb-2">Two-Factor Verification</h1>
                <p class="text-muted mb-4">Enter the 6-digit code from your authenticator app.</p>

                <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

                <form method="POST" action="/verify-2fa">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-4">
                        <input type="text" name="code" class="form-control form-control-lg text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow">Verify</button>
                </form>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
