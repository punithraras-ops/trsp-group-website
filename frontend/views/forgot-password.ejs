<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding bg-light page-offset">
    <div class="container" style="max-width: 480px;">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 fw-bold mb-3">Forgot Password</h1>
                <p class="text-muted mb-4">Enter the email address on your account and we'll send you a link to reset your password.</p>

                <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
                <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

                <form method="POST" action="/forgot-password">
                    <div class="mb-3">
                        <input type="email" name="email" class="form-control form-control-lg rounded-pill" placeholder="Email" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow">Send Reset Link</button>
                </form>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
