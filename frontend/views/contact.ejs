<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="hero text-center text-white d-flex align-items-center contact-hero">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4" data-aos="fade-up"><%= site.contact_heading %></h1>
        <p class="lead mb-5" data-aos="fade-up" data-aos-delay="200"><%= site.contact_subheading %></p>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h3 class="fw-bold mb-4"><%= site.contact_form_heading %></h3>
                <div class="alert d-none" data-form-status role="status" aria-live="polite"></div>
                <form data-contact-form>
                    <div class="mb-4">
                        <input type="text" name="name" class="form-control form-control-lg rounded-pill" placeholder="<%= site.contact_form_name_placeholder %>" required>
                    </div>
                    <div class="mb-4">
                        <input type="email" name="email" class="form-control form-control-lg rounded-pill" placeholder="<%= site.contact_form_email_placeholder %>" required>
                    </div>
                    <div class="mb-4">
                        <input type="tel" name="phone" class="form-control form-control-lg rounded-pill" placeholder="<%= site.contact_form_phone_placeholder %>">
                    </div>
                    <div class="mb-4">
                        <select name="service" class="form-control form-control-lg rounded-pill">
                            <option value=""><%= site.contact_form_service_placeholder %></option>
                            <% services.forEach(service => { %>
                                <option value="<%= service.slug %>" <%= selectedService === service.slug ? 'selected' : '' %>><%= service.title %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-4">
                        <textarea name="message" class="form-control form-control-lg rounded-3" rows="6" placeholder="<%= site.contact_form_message_placeholder %>" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow">
                        <span data-submit-label><%= site.contact_form_submit_label %></span>
                    </button>
                </form>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <h3 class="fw-bold mb-4"><%= site.contact_location_heading %></h3>
                <p class="lead mb-4">
                    <%= site.address %><br>
                    <%= site.location %> - <%= site.postal_code %><br>
                    Phone: <%= site.phone_display %><br>
                    Email: <%= site.email %>
                </p>

                <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow-lg">
                    <iframe src="<%= site.contact_map_embed_url %>" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
