<%
    const welcomeTextColor = design.cardColors.welcome_text_color || '#ffffff';
    const welcomeBgColor1 = design.cardColors.welcome_bg_color_1 || design.colors.dark_color;
    const welcomeBgColor2 = design.cardColors.welcome_bg_color_2 || design.colors.primary_color;
    const welcomeLogo = design.images.welcome_logo || design.images.logo || site.icon_path;
%>
<%- include('partials/head') %>

<style>
    body[data-page="welcome"] {
        margin: 0;
        min-height: 100vh;
        overflow: hidden;
    }

    .welcome-screen {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 1.5rem;
        background: linear-gradient(135deg, var(--welcome-bg-1) 0%, var(--welcome-bg-2) 100%);
        overflow: hidden;
    }

    .welcome-screen::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.10), transparent 45%),
            radial-gradient(circle at 80% 75%, rgba(255, 255, 255, 0.08), transparent 50%);
        pointer-events: none;
        z-index: 1;
    }

    .welcome-bg-media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    .welcome-bg-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, color-mix(in srgb, var(--welcome-bg-1) 72%, transparent), color-mix(in srgb, var(--welcome-bg-2) 62%, transparent));
        z-index: 0;
    }

    .welcome-inner {
        position: relative;
        z-index: 2;
        max-width: 620px;
        color: var(--welcome-text);
        animation: welcomeRise 0.9s ease both;
    }

    .welcome-logo {
        height: 64px;
        width: auto;
        margin-bottom: 1.75rem;
        filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.25));
    }

    .welcome-tagline {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--welcome-text) 78%, transparent);
        margin-bottom: 1rem;
    }

    .welcome-heading {
        font-size: clamp(1.75rem, 4.5vw, 2.9rem);
        font-weight: 700;
        line-height: 1.25;
        margin-bottom: 2.5rem;
        text-wrap: balance;
        color: var(--welcome-text);
    }

    .welcome-progress-track {
        width: min(320px, 70vw);
        height: 4px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--welcome-text) 22%, transparent);
        margin: 0 auto 2rem;
        overflow: hidden;
    }

    .welcome-progress-fill {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: var(--welcome-text);
        animation-name: welcomeFill;
        animation-timing-function: linear;
        animation-fill-mode: forwards;
    }

    .welcome-skip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--welcome-text) 50%, transparent);
        color: var(--welcome-text);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.92rem;
        transition: background 0.25s ease, border-color 0.25s ease;
    }

    .welcome-skip:hover {
        background: color-mix(in srgb, var(--welcome-text) 14%, transparent);
        border-color: var(--welcome-text);
        color: var(--welcome-text);
    }

    @keyframes welcomeFill {
        from { width: 0%; }
        to { width: 100%; }
    }

    @keyframes welcomeRise {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .welcome-inner { animation: none; }
        .welcome-progress-fill { animation: none; width: 100%; }
    }
</style>

<div class="welcome-screen" style="--welcome-bg-1: <%= welcomeBgColor1 %>; --welcome-bg-2: <%= welcomeBgColor2 %>; --welcome-text: <%= welcomeTextColor %>;<% if (!design.welcomeVideo && design.images.welcome_background) { %> background-image: linear-gradient(135deg, color-mix(in srgb, var(--welcome-bg-1) 72%, transparent), color-mix(in srgb, var(--welcome-bg-2) 62%, transparent)), url('<%= design.images.welcome_background %>'); background-size: cover; background-position: center;<% } %>">
    <% if (design.welcomeVideo) { %>
        <video class="welcome-bg-media" autoplay muted loop playsinline <% if (design.images.welcome_background) { %>poster="<%= design.images.welcome_background %>"<% } %>>
            <source src="<%= design.welcomeVideo %>">
        </video>
        <div class="welcome-bg-scrim"></div>
    <% } %>
    <div class="welcome-inner">
        <% if (welcomeLogo) { %>
            <img src="<%= welcomeLogo %>" alt="<%= site.legal_name %>" class="welcome-logo">
        <% } %>
        <span class="welcome-tagline"><%= site.welcome_tagline %></span>
        <h1 class="welcome-heading"><%= site.welcome_heading %></h1>
        <div class="welcome-progress-track">
            <div class="welcome-progress-fill" style="animation-duration: <%= duration %>s;"></div>
        </div>
        <a href="/" class="welcome-skip"><%= site.welcome_button_label %> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </div>
</div>

<script>
    setTimeout(function () {
        window.location.href = '/';
    }, <%= duration * 1000 %>);
</script>
</body>
</html>
