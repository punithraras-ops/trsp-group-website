<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="section-padding bg-light page-offset">
    <div class="container" style="max-width: 480px;">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 fw-bold mb-3">Reset Password</h1>

                <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

                <% if (valid) { %>
                    <form method="POST" action="/reset-password/<%= token %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="password" class="form-control form-control-lg rounded-pill" minlength="8" placeholder="New password (min 8 characters)" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input type="password" name="confirm_password" class="form-control form-control-lg rounded-pill" minlength="8" placeholder="Confirm new password" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow">Update Password</button>
                    </form>
                <% } else { %>
                    <p class="text-muted">This reset link is invalid or has expired. <a href="/forgot-password">Request a new one</a>.</p>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
