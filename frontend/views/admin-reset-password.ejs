<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= site.short_name %> - Set New Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background: #0f172a;">
<div class="card border-0 shadow-lg rounded-4" style="width: 100%; max-width: 420px;">
    <div class="card-body p-4">
        <h3 class="fw-bold text-center mb-2">Set a New Password</h3>
        <p class="text-muted text-center mb-4">Code verified. Choose a new admin password (min 8 characters).</p>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/admin/reset-password">
            <input type="hidden" name="token" value="<%= token %>">
            <div class="mb-4">
                <input type="password" name="password" class="form-control form-control-lg" placeholder="New password" minlength="8" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Set New Password</button>
        </form>
    </div>
</div>
</body>
</html>
