<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="hero text-center text-white d-flex align-items-center services-hero">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9" data-aos="fade-up">
                <span class="hero-kicker"><%= site.store_hero_kicker %></span>
                <h1 class="hero-title display-3 fw-bold mb-4"><%= site.store_hero_heading %></h1>
                <p class="hero-description lead mb-0"><%= site.store_hero_description %></p>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <% if (!dbConfigured) { %>
            <div class="alert alert-info text-center">The store is not fully configured yet. Please check back soon.</div>
        <% } else { %>
            <form method="GET" action="/store" class="row g-2 justify-content-center mb-5">
                <div class="col-md-5">
                    <input type="text" name="q" class="form-control form-control-lg rounded-pill" placeholder="Search products..." value="<%= search %>">
                </div>
                <% if (categories.length > 0) { %>
                <div class="col-md-3">
                    <select name="category" class="form-select form-select-lg rounded-pill">
                        <option value="">All Categories</option>
                        <% categories.forEach(c => { %>
                            <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
                        <% }) %>
                    </select>
                </div>
                <% } %>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill">Search</button>
                </div>
            </form>

            <% if (products.length === 0) { %>
                <div class="alert alert-info text-center">No products match your search. <a href="/store">Clear filters</a></div>
            <% } else { %>
            <div class="row g-4 justify-content-center">
                <% products.forEach(product => { %>
                    <div class="col-lg-4 col-md-6" data-aos="zoom-in">
                        <div class="card service-card h-100 border-0 shadow-lg">
                            <% if (product.images && product.images.length > 0) { %>
                                <img src="/uploads/<%= product.images[0] %>" alt="<%= product.title %>" class="img-fluid" style="border-radius: 1rem 1rem 0 0; aspect-ratio: 4/3; object-fit: cover;">
                            <% } %>
                            <div class="card-body d-flex flex-column p-4">
                                <% if (product.category) { %><span class="badge bg-light text-dark border mb-2 align-self-start"><%= product.category %></span><% } %>
                                <h4 class="fw-bold"><%= product.title %></h4>
                                <p class="text-muted flex-grow-1"><%= product.description %></p>
                                <button type="button" class="btn btn-link p-0 text-start mb-2 text-decoration-none" data-open-reviews="<%= product.id %>" data-product-title="<%= product.title %>" title="Project Quality Rating">
                                    <% const avg = product.reviewSummary.avg || 0; %>
                                    <% for (let i = 1; i <= 5; i++) { %><i class="fa-star <%= i <= Math.round(avg) ? 'fas text-warning' : 'far text-muted' %>"></i><% } %>
                                    <span class="text-muted small ms-1">(<%= product.reviewSummary.count %> Quality Rating<%= product.reviewSummary.count === 1 ? '' : 's' %>)</span>
                                </button>
                                <p class="fs-4 fw-bold text-primary mb-3">&#8377;<%= (product.price_paise / 100).toLocaleString('en-IN') %></p>
                                <div class="d-flex gap-2 mt-auto">
                                    <a href="/checkout?product=<%= product.id %>" class="btn btn-primary flex-grow-1">Buy Now</a>
                                    <% if (!product.requires_approval) { %>
                                        <button type="button" class="btn btn-outline-primary" data-add-to-cart="<%= product.id %>" title="Add to Cart"><i class="fas fa-cart-plus"></i></button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
            <% } %>
        <% } %>
    </div>
</section>

<div class="modal fade" id="reviewsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="reviewsModalTitle">Project Quality Rating</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <div id="reviewsList"><p class="text-muted">Loading...</p></div>
                <div id="reviewFormWrap" class="d-none mt-4 pt-3 border-top">
                    <h6 class="fw-bold mb-2">Rate this project</h6>
                    <div class="mb-2" id="reviewStarInput">
                        <% for (let i = 1; i <= 5; i++) { %><i class="far fa-star fs-5 text-warning me-1" data-star="<%= i %>" style="cursor:pointer;"></i><% } %>
                    </div>
                    <textarea id="reviewComment" class="form-control mb-2" rows="2" placeholder="Optional comment"></textarea>
                    <button class="btn btn-primary btn-sm" id="submitReviewBtn">Submit Review</button>
                    <div id="reviewSubmitStatus" class="small mt-2"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/store.js"></script>

<%- include('partials/footer') %>
