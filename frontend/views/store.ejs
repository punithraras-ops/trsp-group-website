<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="hero text-center text-white d-flex align-items-center services-hero">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9" data-aos="fade-up">
                <span class="hero-kicker">Store</span>
                <h1 class="hero-title display-3 fw-bold mb-4">Packages &amp; Products</h1>
                <p class="hero-description lead mb-0">Purchase a package directly online, or contact us for a custom quote.</p>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-light">
    <div class="container">
        <% if (!dbConfigured) { %>
            <div class="alert alert-info text-center">The store is not fully configured yet. Please check back soon.</div>
        <% } else if (products.length === 0) { %>
            <div class="alert alert-info text-center">No products are available right now. Please check back soon.</div>
        <% } else { %>
            <div class="row g-4 justify-content-center">
                <% products.forEach(product => { %>
                    <div class="col-lg-4 col-md-6" data-aos="zoom-in">
                        <div class="card service-card h-100 border-0 shadow-lg">
                            <% if (product.image_url) { %>
                                <img src="<%= product.image_url %>" alt="<%= product.title %>" class="img-fluid" style="border-radius: 1rem 1rem 0 0;">
                            <% } %>
                            <div class="card-body d-flex flex-column p-4">
                                <h4 class="fw-bold"><%= product.title %></h4>
                                <p class="text-muted flex-grow-1"><%= product.description %></p>
                                <p class="fs-4 fw-bold text-primary mb-3">&#8377;<%= (product.price_paise / 100).toLocaleString('en-IN') %></p>
                                <a href="/checkout?product=<%= product.id %>" class="btn btn-primary btn-lg mt-auto">Buy Now</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<%- include('partials/footer') %>
