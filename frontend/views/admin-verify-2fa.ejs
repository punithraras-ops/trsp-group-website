<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Verify Code' }) %>
<body class="admin-auth-page d-flex align-items-center justify-content-center" style="min-height: 100vh;">
<div class="card border-0 shadow-lg rounded-4" style="width: 100%; max-width: 400px;">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <i class="fas fa-mobile-screen-button" style="font-size: 2rem; color: #4f46e5;"></i>
        </div>
        <h3 class="fw-bold text-center mb-2">Two-Factor Verification</h3>
        <p class="text-muted text-center mb-4">Enter the 6-digit code from your authenticator app.</p>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/admin/verify-2fa">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-4">
                <input type="text" name="code" class="form-control form-control-lg text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Verify</button>
        </form>
        <div class="text-center">
            <a href="/admin/login">Back to login</a>
        </div>
    </div>
</div>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
