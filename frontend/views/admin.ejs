<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Admin' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>; --admin-accent: <%= design.adminColors.admin_accent %>; --admin-accent-dark: <%= design.adminColors.admin_accent_dark %>; --admin-text: <%= design.adminColors.admin_text %>; --admin-surface: <%= design.adminColors.admin_surface %>;">

<div class="admin-topbar">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <% if (design.images.logo || site.icon_path) { %>
                <img src="<%= design.images.logo || site.icon_path %>" alt="<%= site.legal_name %> logo" class="admin-logo-mark">
            <% } %>
            <h1 class="mb-0"><i class="fas fa-gauge-high me-2 text-primary" style="color: var(--admin-accent) !important;"></i>Admin Dashboard<span class="badge-live"><i class="fas fa-circle"></i>Live</span></h1>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <%- include('partials/language-switcher') %>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.location.reload();"><i class="fas fa-rotate me-1"></i>Refresh</button>
            <a href="/admin/tickets" class="btn btn-outline-primary btn-sm admin-nav-tickets" title="Tickets"><i class="fas fa-ticket me-1"></i>Tickets</a>
            <a href="/admin/site-info" class="btn btn-outline-primary btn-sm admin-nav-siteinfo"><i class="fas fa-building me-1"></i>Site Info</a>
            <a href="/admin/design" class="btn btn-outline-primary btn-sm admin-nav-sitedesign"><i class="fas fa-palette me-1"></i>Site Design</a>
            <a href="/admin/legal" class="btn btn-outline-primary btn-sm admin-nav-legal"><i class="fas fa-file-contract me-1"></i>Legal</a>
            <a href="/admin/coupons" class="btn btn-outline-primary btn-sm admin-nav-coupons"><i class="fas fa-tags me-1"></i>Coupons</a>
            <a href="/admin/audit-log" class="btn btn-outline-primary btn-sm admin-nav-auditlog"><i class="fas fa-clock-rotate-left me-1"></i>Audit Log</a>
            <a href="/admin/security" class="btn btn-outline-primary btn-sm admin-nav-security"><i class="fas fa-shield-halved me-1"></i>Security</a>
            <a href="/admin/logout" class="btn btn-outline-secondary btn-sm admin-nav-logout"><i class="fas fa-arrow-right-from-bracket me-1"></i>Logout</a>
        </div>
    </div>
</div>

<main class="admin-page-main">
<div class="container-fluid px-4 pb-5">

    <% if (!dbConfigured) { %>
        <div class="alert alert-warning">MONGODB_URI is not configured. User accounts, orders, products, and upcoming features are unavailable until it is set. Contact submissions below are read from the database once it is configured.</div>
    <% } %>

    <% const pendingApprovalCount = orders.filter(o => o.status === 'pending_approval').length; %>
    <% const pendingUpiCount = orders.filter(o => o.status === 'awaiting_upi_confirmation').length; %>

    <% if (pendingUpiCount > 0) { %>
        <div class="toast-notification toast-warning" data-admin-upi-toast role="status">
            <i class="fas fa-qrcode me-2"></i><%= pendingUpiCount %> UPI payment<%= pendingUpiCount > 1 ? 's' : '' %> awaiting your confirmation &mdash; check the Orders tab.
        </div>
    <% } %>
    <% const revenuePaise = orders.filter(o => o.status === 'paid').reduce((sum, o) => sum + (o.amount_paise || 0), 0); %>
    <div class="admin-stats">
        <div class="admin-stat-card" style="animation-delay: 0.02s;<%- include('partials/frame-bg-style', { color: design.cardColors.admin_stat_submissions_bg, image: design.images.admin_stat_submissions_bg, overlay: 'light' }) %>">
            <div class="stat-icon"><i class="fas fa-envelope"></i></div>
            <div class="stat-value"><%= submissions.length %></div>
            <div class="stat-label">Contact Submissions</div>
        </div>
        <div class="admin-stat-card" style="animation-delay: 0.06s;<%- include('partials/frame-bg-style', { color: design.cardColors.admin_stat_users_bg, image: design.images.admin_stat_users_bg, overlay: 'light' }) %>">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-value"><%= users.length %></div>
            <div class="stat-label">Registered Users</div>
        </div>
        <div class="admin-stat-card" style="animation-delay: 0.1s;<%- include('partials/frame-bg-style', { color: design.cardColors.admin_stat_orders_bg, image: design.images.admin_stat_orders_bg, overlay: 'light' }) %>">
            <div class="stat-icon"><i class="fas fa-bag-shopping"></i></div>
            <div class="stat-value"><%= orders.length %></div>
            <div class="stat-label">Total Orders</div>
        </div>
        <div class="admin-stat-card" style="animation-delay: 0.14s;<%- include('partials/frame-bg-style', { color: design.cardColors.admin_stat_pending_bg, image: design.images.admin_stat_pending_bg, overlay: 'light' }) %>">
            <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
            <div class="stat-value"><%= pendingApprovalCount %></div>
            <div class="stat-label">Pending Approvals</div>
        </div>
        <div class="admin-stat-card" style="animation-delay: 0.18s;<%- include('partials/frame-bg-style', { color: design.cardColors.admin_stat_upi_bg, image: design.images.admin_stat_upi_bg, overlay: 'light' }) %>">
            <div class="stat-icon"><i class="fas fa-qrcode"></i></div>
            <div class="stat-value"><%= pendingUpiCount %></div>
            <div class="stat-label">Pending UPI Confirmations</div>
        </div>
        <div class="admin-stat-card" style="animation-delay: 0.22s;<%- include('partials/frame-bg-style', { color: design.cardColors.admin_stat_revenue_bg, image: design.images.admin_stat_revenue_bg, overlay: 'light' }) %>">
            <div class="stat-icon"><i class="fas fa-indian-rupee-sign"></i></div>
            <div class="stat-value">&#8377;<%= (revenuePaise / 100).toLocaleString('en-IN') %></div>
            <div class="stat-label">Revenue (Paid)</div>
        </div>
    </div>

    <div class="admin-tabs-scroll-wrapper mb-4">
        <button type="button" class="admin-tabs-scroll-btn admin-tabs-scroll-left" aria-label="Scroll tabs left"><i class="fas fa-chevron-left"></i></button>
        <ul class="nav nav-tabs" id="adminTab" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-submissions" type="button"><i class="fas fa-envelope me-1"></i>Submissions (<%= submissions.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-users" type="button"><i class="fas fa-users me-1"></i>Users (<%= users.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-orders" type="button"><i class="fas fa-bag-shopping me-1"></i>Orders (<%= orders.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-services" type="button"><i class="fas fa-briefcase me-1"></i>Services (<%= services.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-products" type="button"><i class="fas fa-box me-1"></i>Products (<%= products.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-features" type="button"><i class="fas fa-rocket me-1"></i>Upcoming Features (<%= features.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reviews" type="button"><i class="fas fa-star me-1"></i>Reviews (<%= productReviews.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-testimonials" type="button"><i class="fas fa-quote-left me-1"></i>Testimonials (<%= testimonials.length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-research" type="button"><i class="fas fa-flask me-1"></i>Research Verticals (<%= researchVerticals.length %>)</button></li>
        </ul>
        <button type="button" class="admin-tabs-scroll-btn admin-tabs-scroll-right" aria-label="Scroll tabs right"><i class="fas fa-chevron-right"></i></button>
    </div>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="tab-submissions">
            <h3 class="mb-3">Contact Submissions</h3>
            <% if (submissions.length === 0) { %>
                <p>No submissions yet.</p>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead><tr><th>Date</th><th>Name</th><th>Email</th><th>Phone</th><th>Service</th><th>Message</th></tr></thead>
                    <tbody>
                        <% submissions.forEach(s => { %>
                            <tr>
                                <td class="text-nowrap"><%= new Date(s.created_at).toLocaleString('en-IN') %></td>
                                <td><%= s.name %></td>
                                <td><a href="mailto:<%= s.email %>"><%= s.email %></a></td>
                                <td><%= s.phone %></td>
                                <td><%= s.service %></td>
                                <td><%= s.message %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <div class="tab-pane fade" id="tab-users">
            <h3 class="mb-3">Registered Users</h3>
            <% if (users.length === 0) { %>
                <p>No registered users yet.</p>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Sign-in Method</th><th>Joined</th></tr></thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr>
                                <td><%= u.id %></td>
                                <td><%= u.name %></td>
                                <td><%= u.email %></td>
                                <td><%= u.phone || '—' %></td>
                                <td><%= u.address || '—' %></td>
                                <td><%= u.google_id ? 'Google' : (u.github_id ? 'GitHub' : 'Email/Password') %></td>
                                <td class="text-nowrap"><%= new Date(u.created_at).toLocaleString('en-IN') %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <div class="tab-pane fade" id="tab-orders">
            <h3 class="mb-3">Orders</h3>
            <% if (orders.length === 0) { %>
                <p>No orders yet.</p>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead><tr><th>ID</th><th>User</th><th>Product</th><th>Amount</th><th>Status</th><th>Date</th><th>Action / Delivery</th><th>Files</th></tr></thead>
                    <tbody>
                        <% orders.forEach(o => { %>
                            <tr>
                                <td><%= o.id %></td>
                                <td><%= o.user_name %> (<%= o.user_email %>)</td>
                                <td><%= o.display_title %></td>
                                <td>&#8377;<%= (o.amount_paise / 100).toLocaleString('en-IN') %></td>
                                <td>
                                    <span class="badge bg-<%= o.status === 'paid' ? 'success' : (o.status === 'failed' || o.status === 'rejected' ? 'danger' : ((o.status === 'pending_approval' || o.status === 'awaiting_upi_confirmation') ? 'warning text-dark' : 'secondary')) %>"><%= o.status.replace(/_/g, ' ') %></span>
                                </td>
                                <td class="text-nowrap"><%= new Date(o.created_at).toLocaleString('en-IN') %></td>
                                <td>
                                    <% if (o.status === 'pending_approval') { %>
                                        <div class="d-flex gap-2">
                                            <form method="POST" action="/admin/orders/<%= o.id %>/approve">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                            </form>
                                            <form method="POST" action="/admin/orders/<%= o.id %>/reject">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        </div>
                                    <% } else if (o.status === 'awaiting_upi_confirmation') { %>
                                        <% if (o.utr_reference) { %>
                                            <div class="small mb-2">UTR: <strong><%= o.utr_reference %></strong> &mdash; check your bank app before confirming.</div>
                                        <% } else { %>
                                            <div class="small text-muted mb-2">Customer hasn't submitted a UTR reference yet.</div>
                                        <% } %>
                                        <div class="d-flex gap-2">
                                            <form method="POST" action="/admin/orders/<%= o.id %>/confirm-manual-upi" data-confirm="Confirm you have verified this UPI payment in your bank/UPI app? This will mark the order paid and deliver the product.">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-success">Confirm Paid</button>
                                            </form>
                                            <form method="POST" action="/admin/orders/<%= o.id %>/reject-manual-upi" data-confirm="Reject this UPI payment claim?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        </div>
                                    <% } else if (o.status === 'paid') { %>
                                        <form method="POST" action="/admin/orders/<%= o.id %>/delivery-status" class="d-flex gap-2">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <select name="delivery_status" class="form-select form-select-sm">
                                                <% ['processing','shipped','delivered','cancelled'].forEach(s => { %>
                                                    <option value="<%= s %>" <%= (o.delivery_status || 'processing') === s ? 'selected' : '' %>><%= s %></option>
                                                <% }) %>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-primary text-nowrap">Save</button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-muted">&mdash;</span>
                                    <% } %>
                                    <% if (o.status === 'paid') { %>
                                        <a href="/admin/orders/<%= o.id %>/invoice" class="btn btn-sm btn-outline-secondary mt-1"><i class="fas fa-file-invoice me-1"></i>Invoice</a>
                                    <% } %>
                                </td>
                                <td style="min-width: 200px;">
                                    <% if (o.status === 'paid') { %>
                                        <% (o.deliverable_files || []).forEach(f => { %>
                                            <div class="d-flex align-items-center gap-1 mb-1">
                                                <span class="badge bg-light text-dark border text-truncate" style="max-width: 140px;" title="<%= f.filename %>"><i class="fas fa-file me-1"></i><%= f.filename %></span>
                                                <form method="POST" action="/admin/orders/<%= o.id %>/deliverable/<%= f.id %>/remove" data-confirm="Remove this file?">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">&times;</button>
                                                </form>
                                            </div>
                                        <% }) %>
                                        <form method="POST" action="/admin/orders/<%= o.id %>/deliverable" enctype="multipart/form-data" class="d-flex gap-1 flex-wrap" data-ajax-upload>
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="file" name="files" multiple class="form-control form-control-sm">
                                            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Add</button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-muted">&mdash;</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <div class="tab-pane fade" id="tab-services">
            <h3 class="mb-3">Services</h3>
            <p class="text-muted">These are the services shown on the Home and Services pages. Each one gets its own detail page at <code>/services/&lt;slug&gt;</code>. Enter features as one per line: <code>Title :: Description</code>.</p>
            <div class="table-responsive mb-4">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead><tr><th style="min-width:160px">Title</th><th>Slug</th><th>Icon (Font Awesome class)</th><th style="min-width:220px">Summary</th><th style="min-width:260px">Features (one per line: Title :: Description)</th><th>Order</th><th>Active</th><th></th><th style="min-width:180px">Card Background</th></tr></thead>
                    <tbody>
                        <% services.forEach(s => { %>
                            <tr>
                                <form method="POST" action="/admin/services/<%= s.id %>/update">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <td><input type="text" name="title" class="form-control" value="<%= s.title %>" required></td>
                                    <td><input type="text" name="slug" class="form-control" value="<%= s.slug %>" required></td>
                                    <td><input type="text" name="icon" class="form-control" value="<%= s.icon %>" placeholder="fas fa-briefcase"></td>
                                    <td><textarea name="summary" class="form-control" rows="2"><%= s.summary %></textarea></td>
                                    <td><textarea name="features" class="form-control" rows="4"><%= s.featuresText %></textarea></td>
                                    <td><input type="number" name="sort_order" class="form-control" value="<%= s.sort_order %>"></td>
                                    <td class="text-center"><input type="checkbox" name="is_active" value="1" <%= s.is_active ? 'checked' : '' %>></td>
                                    <td class="text-nowrap">
                                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                    </td>
                                </form>
                                <td>
                                    <form method="POST" action="/admin/services/<%= s.id %>/delete" data-confirm="Delete this service?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                                <td>
                                    <% if (s.background_image) { %>
                                        <img src="<%= s.background_image %>" class="rounded border d-block mb-1" style="width:70px;height:50px;object-fit:cover;">
                                        <form method="POST" action="/admin/services/<%= s.id %>/background/remove" data-confirm="Remove this background image?" class="mb-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">Remove</button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/admin/services/<%= s.id %>/background" enctype="multipart/form-data" data-ajax-upload class="mb-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="file" name="background" accept="image/*" class="form-control form-control-sm mb-1">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Upload</button>
                                        </form>
                                    <% } %>
                                    <form method="POST" action="/admin/services/<%= s.id %>/background-color" class="d-flex gap-1">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="color" name="color" class="form-control form-control-color form-control-sm" value="<%= s.background_color || '#ffffff' %>">
                                        <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-1">Color</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <h4 class="mb-3">Add Service</h4>
            <form method="POST" action="/admin/services" class="row g-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-3"><label class="form-label">Title</label><input type="text" name="title" class="form-control" required></div>
                <div class="col-md-3"><label class="form-label">Slug (URL, optional)</label><input type="text" name="slug" class="form-control" placeholder="auto from title"></div>
                <div class="col-md-2"><label class="form-label">Icon (Font Awesome)</label><input type="text" name="icon" class="form-control" placeholder="fas fa-briefcase"></div>
                <div class="col-md-2"><label class="form-label">Order</label><input type="number" name="sort_order" class="form-control" value="0"></div>
                <div class="col-md-2"><label class="form-label">CTA Label</label><input type="text" name="cta_label" class="form-control" placeholder="View Detailed Features"></div>
                <div class="col-md-6"><label class="form-label">Summary (short card text)</label><textarea name="summary" class="form-control" rows="2" required></textarea></div>
                <div class="col-md-6"><label class="form-label">Hero Subtitle (detail page)</label><textarea name="hero_subtitle" class="form-control" rows="2"></textarea></div>
                <div class="col-12"><label class="form-label">Features (one per line: Title :: Description)</label><textarea name="features" class="form-control" rows="4" placeholder="Custom Web Applications :: Built with modern frameworks..."></textarea></div>
                <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Add Service</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tab-products">
            <h3 class="mb-3">Products</h3>
            <p class="text-muted">Each product can have up to 10 images. Uploading images is optional — add as many or as few as you need.</p>

            <% if (products.some(p => p.requires_approval)) { %>
                <div class="alert alert-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                    <span><i class="fas fa-bolt me-2"></i>Skip manual approval for every product (any price) so customers go straight to payment.</span>
                    <form method="POST" action="/admin/products/bulk-disable-approval" data-confirm="Turn off 'Requires Approval' for ALL products, regardless of price? Customers will be able to buy instantly.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-primary">Enable instant checkout for all products</button>
                    </form>
                </div>
            <% } %>

            <% products.forEach(p => { %>
                <div class="card mb-3 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <h6 class="fw-bold mb-2">Images (<%= (p.images || []).length %>/10)</h6>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <% (p.images || []).forEach(fileId => { %>
                                        <div class="text-center">
                                            <img src="/uploads/<%= fileId %>" class="rounded border d-block mb-1" style="width:70px;height:70px;object-fit:cover;">
                                            <form method="POST" action="/admin/products/<%= p.id %>/images/remove" data-confirm="Remove this image?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="fileId" value="<%= fileId %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">Remove</button>
                                            </form>
                                        </div>
                                    <% }) %>
                                </div>
                                <% if ((p.images || []).length < 10) { %>
                                    <form method="POST" action="/admin/products/<%= p.id %>/images" enctype="multipart/form-data" class="d-flex gap-2 flex-wrap" data-ajax-upload>
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="file" name="files" accept="image/*" multiple class="form-control form-control-sm">
                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Add</button>
                                    </form>
                                <% } %>
                            </div>
                            <div class="col-md-8">
                                <form method="POST" action="/admin/products/<%= p.id %>/update">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-5"><label class="form-label">Title</label><input type="text" name="title" class="form-control" value="<%= p.title %>" required></div>
                                        <div class="col-md-3"><label class="form-label">Price (INR)</label><input type="number" name="price" class="form-control" value="<%= (p.price_paise / 100).toFixed(2) %>" step="0.01" min="0" required></div>
                                        <div class="col-md-2"><label class="form-label">Category</label><input type="text" name="category" class="form-control" value="<%= p.category || '' %>"></div>
                                        <div class="col-md-2 d-flex align-items-end">
                                            <div class="form-check">
                                                <input type="checkbox" name="is_active" value="1" class="form-check-input" id="active-<%= p.id %>" <%= p.is_active ? 'checked' : '' %>>
                                                <label class="form-check-label" for="active-<%= p.id %>">Active</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-2"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2"><%= p.description %></textarea></div>
                                    <div class="form-check mb-2">
                                        <input type="checkbox" name="requires_approval" value="1" class="form-check-input" id="approval-<%= p.id %>" <%= p.requires_approval ? 'checked' : '' %>>
                                        <label class="form-check-label" for="approval-<%= p.id %>">Requires approval before payment (customer requests it, you approve, then they can pay)</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="checkbox" name="auto_approve" value="1" class="form-check-input" id="auto-approve-<%= p.id %>" <%= p.auto_approve ? 'checked' : '' %>>
                                        <label class="form-check-label" for="auto-approve-<%= p.id %>">Auto-approve requests (skips manual review above &mdash; goes straight to "ready to pay")</label>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                </form>
                                <form method="POST" action="/admin/products/<%= p.id %>/delete" data-confirm="Delete this product?" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger mt-2">Delete Product</button>
                                </form>

                                <div class="mt-3 pt-3 border-top">
                                    <h6 class="fw-bold mb-2"><i class="fas fa-download me-1"></i>Deliverable File <span class="text-muted fw-normal small">(sent to every buyer once paid)</span></h6>
                                    <% if (p.deliverable_filename) { %>
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="badge bg-light text-dark border"><i class="fas fa-file me-1"></i><%= p.deliverable_filename %></span>
                                            <form method="POST" action="/admin/products/<%= p.id %>/deliverable/remove" data-confirm="Remove this deliverable file?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">Remove</button>
                                            </form>
                                        </div>
                                    <% } %>
                                    <form method="POST" action="/admin/products/<%= p.id %>/deliverable" enctype="multipart/form-data" class="d-flex gap-2 flex-wrap" data-ajax-upload>
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="file" name="deliverable" class="form-control form-control-sm">
                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><%= p.deliverable_filename ? 'Replace' : 'Upload' %></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>

            <h4 class="mb-3 mt-4">Add Product</h4>
            <form method="POST" action="/admin/products" enctype="multipart/form-data" class="row g-2" data-ajax-upload>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4"><label class="form-label">Title</label><input type="text" name="title" class="form-control" required></div>
                <div class="col-md-2"><label class="form-label">Price (INR)</label><input type="number" name="price" class="form-control" step="0.01" min="0" required></div>
                <div class="col-md-2"><label class="form-label">Category</label><input type="text" name="category" class="form-control" placeholder="e.g. Software"></div>
                <div class="col-md-4"><label class="form-label">Description</label><input type="text" name="description" class="form-control"></div>
                <div class="col-md-8">
                    <label class="form-label">Images (optional, up to 10)</label>
                    <input type="file" name="images" accept="image/*" multiple class="form-control">
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input type="checkbox" name="requires_approval" value="1" class="form-check-input" id="approval-new">
                        <label class="form-check-label" for="approval-new">Requires approval before payment</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="auto_approve" value="1" class="form-check-input" id="auto-approve-new">
                        <label class="form-check-label" for="auto-approve-new">Auto-approve requests (skips manual review above)</label>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100">Add Product</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tab-features">
            <h3 class="mb-3">Upcoming Features</h3>
            <div class="table-responsive mb-4">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead><tr><th>Title</th><th>Description</th><th>Status</th><th>Order</th><th>Active</th><th></th><th style="min-width:180px">Card Background</th></tr></thead>
                    <tbody>
                        <% features.forEach(f => { %>
                            <tr>
                                <form method="POST" action="/admin/features/<%= f.id %>/update">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <td><input type="text" name="title" class="form-control" value="<%= f.title %>" required></td>
                                    <td><input type="text" name="description" class="form-control" value="<%= f.description %>"></td>
                                    <td>
                                        <select name="status" class="form-select">
                                            <% ['planned','in_progress','shipped'].forEach(s => { %>
                                                <option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= s %></option>
                                            <% }) %>
                                        </select>
                                    </td>
                                    <td><input type="number" name="sort_order" class="form-control" value="<%= f.sort_order %>"></td>
                                    <td class="text-center"><input type="checkbox" name="is_active" value="1" <%= f.is_active ? 'checked' : '' %>></td>
                                    <td class="text-nowrap">
                                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                    </td>
                                </form>
                                <td>
                                    <form method="POST" action="/admin/features/<%= f.id %>/delete" data-confirm="Delete this feature?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                                <td>
                                    <% if (f.background_image) { %>
                                        <img src="<%= f.background_image %>" class="rounded border d-block mb-1" style="width:70px;height:50px;object-fit:cover;">
                                        <form method="POST" action="/admin/features/<%= f.id %>/background/remove" data-confirm="Remove this background image?" class="mb-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">Remove</button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/admin/features/<%= f.id %>/background" enctype="multipart/form-data" data-ajax-upload class="mb-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="file" name="background" accept="image/*" class="form-control form-control-sm mb-1">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Upload</button>
                                        </form>
                                    <% } %>
                                    <form method="POST" action="/admin/features/<%= f.id %>/background-color" class="d-flex gap-1">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="color" name="color" class="form-control form-control-color form-control-sm" value="<%= f.background_color || '#ffffff' %>">
                                        <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-1">Color</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <h4 class="mb-3">Add Upcoming Feature</h4>
            <form method="POST" action="/admin/features" class="row g-2 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-3"><label class="form-label">Title</label><input type="text" name="title" class="form-control" required></div>
                <div class="col-md-4"><label class="form-label">Description</label><input type="text" name="description" class="form-control"></div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="planned">planned</option>
                        <option value="in_progress">in_progress</option>
                        <option value="shipped">shipped</option>
                    </select>
                </div>
                <div class="col-md-1"><label class="form-label">Order</label><input type="number" name="sort_order" class="form-control" value="0"></div>
                <div class="col-md-1 d-flex align-items-center">
                    <div class="form-check">
                        <input type="checkbox" name="is_active" value="1" class="form-check-input" id="feature-active-new" checked>
                        <label class="form-check-label" for="feature-active-new">Active</label>
                    </div>
                </div>
                <div class="col-md-1"><button type="submit" class="btn btn-primary w-100">Add</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tab-testimonials">
            <h3 class="mb-3">Testimonials <span class="text-muted fw-normal small">("What Clients Say" on the homepage)</span></h3>
            <div class="table-responsive mb-4">
                <table class="table table-striped align-middle bg-white rounded shadow-sm">
                    <thead><tr><th>Quote</th><th>Author</th><th>Order</th><th></th><th style="min-width:180px">Card Background</th></tr></thead>
                    <tbody>
                        <% testimonials.forEach(t => { %>
                            <tr>
                                <form method="POST" action="/admin/testimonials/<%= t.id %>/update">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <td><textarea name="quote" class="form-control" rows="2" required><%= t.quote %></textarea></td>
                                    <td><input type="text" name="author" class="form-control" value="<%= t.author %>"></td>
                                    <td><input type="number" name="sort_order" class="form-control" value="<%= t.sort_order %>" style="width: 80px;"></td>
                                    <td class="text-nowrap">
                                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                    </td>
                                </form>
                                <td>
                                    <form method="POST" action="/admin/testimonials/<%= t.id %>/delete" data-confirm="Delete this testimonial?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                                <td>
                                    <% if (t.background_image) { %>
                                        <img src="<%= t.background_image %>" class="rounded border d-block mb-1" style="width:70px;height:50px;object-fit:cover;">
                                        <form method="POST" action="/admin/testimonials/<%= t.id %>/background/remove" data-confirm="Remove this background image?" class="mb-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">Remove</button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/admin/testimonials/<%= t.id %>/background" enctype="multipart/form-data" data-ajax-upload class="mb-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="file" name="background" accept="image/*" class="form-control form-control-sm mb-1">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Upload</button>
                                        </form>
                                    <% } %>
                                    <form method="POST" action="/admin/testimonials/<%= t.id %>/background-color" class="d-flex gap-1">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="color" name="color" class="form-control form-control-color form-control-sm" value="<%= t.background_color || '#0a1828' %>">
                                        <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-1">Color</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <h4 class="mb-3">Add Testimonial</h4>
            <form method="POST" action="/admin/testimonials" class="row g-2 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-6"><label class="form-label">Quote</label><textarea name="quote" class="form-control" rows="2" required></textarea></div>
                <div class="col-md-3"><label class="form-label">Author</label><input type="text" name="author" class="form-control" placeholder="Client Name, Company"></div>
                <div class="col-md-2"><label class="form-label">Order</label><input type="number" name="sort_order" class="form-control" value="0"></div>
                <div class="col-md-1"><button type="submit" class="btn btn-primary w-100">Add</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tab-research">
            <h3 class="mb-3">Research Verticals <span class="text-muted fw-normal small">(homepage cards)</span></h3>
            <div class="d-flex flex-column gap-3 mb-4">
                <% researchVerticals.forEach(r => { %>
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <form method="POST" action="/admin/research-verticals/<%= r.id %>/update" class="row g-2">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="col-md-4"><label class="form-label">Title</label><input type="text" name="title" class="form-control" value="<%= r.title %>" required></div>
                                <div class="col-md-2"><label class="form-label">Order</label><input type="number" name="sort_order" class="form-control" value="<%= r.sort_order %>"></div>
                                <div class="col-md-6"><label class="form-label">Summary</label><input type="text" name="summary" class="form-control" value="<%= r.summary %>"></div>
                                <div class="col-12"><label class="form-label">Areas (one per line, shown as a bullet list)</label><textarea name="areas" class="form-control" rows="4"><%= r.areasText %></textarea></div>
                                <div class="col-12 d-flex gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                </div>
                            </form>
                            <form method="POST" action="/admin/research-verticals/<%= r.id %>/delete" data-confirm="Delete this research vertical?" class="mt-2 d-inline-block me-2">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>

                            <div class="border-top mt-3 pt-3">
                                <h6 class="fw-bold small mb-2">Card Background</h6>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <% if (r.background_image) { %>
                                        <img src="<%= r.background_image %>" class="rounded border d-block" style="width:70px;height:50px;object-fit:cover;">
                                        <form method="POST" action="/admin/research-verticals/<%= r.id %>/background/remove" data-confirm="Remove this background image?">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1">Remove Image</button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/admin/research-verticals/<%= r.id %>/background" enctype="multipart/form-data" class="d-flex gap-2" data-ajax-upload>
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="file" name="background" accept="image/*" class="form-control form-control-sm">
                                            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Upload Image</button>
                                        </form>
                                    <% } %>
                                    <form method="POST" action="/admin/research-verticals/<%= r.id %>/background-color" class="d-flex gap-2 align-items-center">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="color" name="color" class="form-control form-control-color form-control-sm" value="<%= r.background_color || '#ffffff' %>">
                                        <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2">Set Color</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <h4 class="mb-3">Add Research Vertical</h4>
            <form method="POST" action="/admin/research-verticals" class="row g-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4"><label class="form-label">Title</label><input type="text" name="title" class="form-control" required></div>
                <div class="col-md-2"><label class="form-label">Order</label><input type="number" name="sort_order" class="form-control" value="0"></div>
                <div class="col-md-6"><label class="form-label">Summary</label><input type="text" name="summary" class="form-control"></div>
                <div class="col-12"><label class="form-label">Areas (one per line)</label><textarea name="areas" class="form-control" rows="4" placeholder="Scalable Distributed Systems&#10;Cloud-Native & Microservices Architecture"></textarea></div>
                <div class="col-12"><button type="submit" class="btn btn-primary">Add</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tab-reviews">
            <h3 class="mb-3">Product Reviews</h3>
            <% if (productReviews.length === 0) { %>
                <p class="text-muted">No reviews yet.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-striped align-middle bg-white rounded shadow-sm">
                        <thead><tr><th>Product</th><th>Customer</th><th>Rating</th><th>Comment</th><th>Date</th><th></th></tr></thead>
                        <tbody>
                            <% productReviews.forEach(r => { %>
                                <tr>
                                    <td><%= r.product_title || 'Unknown product' %></td>
                                    <td><%= r.user_name %></td>
                                    <td><%= r.rating %> <i class="fas fa-star text-warning"></i></td>
                                    <td><%= r.comment %></td>
                                    <td class="text-nowrap"><%= new Date(r.created_at).toLocaleDateString('en-IN') %></td>
                                    <td>
                                        <form method="POST" action="/admin/reviews/<%= r.id %>/delete" data-confirm="Delete this review?">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>

    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<%- include('partials/confirm-modal') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/confirm-modal.js"></script>
<script>
    var requestedTab = new URLSearchParams(window.location.search).get('tab');
    if (requestedTab) {
        var targetTab = document.querySelector('button[data-bs-target="#tab-' + requestedTab + '"]');
        if (targetTab) {
            new bootstrap.Tab(targetTab).show();
        }
    }

    var upiToast = document.querySelector('[data-admin-upi-toast]');
    if (upiToast) {
        setTimeout(function () { upiToast.remove(); }, 5000);
    }

    var adminTabsList = document.getElementById('adminTab');
    var tabsScrollLeft = document.querySelector('.admin-tabs-scroll-left');
    var tabsScrollRight = document.querySelector('.admin-tabs-scroll-right');
    if (adminTabsList && tabsScrollLeft && tabsScrollRight) {
        tabsScrollLeft.addEventListener('click', function () {
            adminTabsList.scrollBy({ left: -150, behavior: 'smooth' });
        });
        tabsScrollRight.addEventListener('click', function () {
            adminTabsList.scrollBy({ left: 150, behavior: 'smooth' });
        });
        adminTabsList.querySelectorAll('.nav-link').forEach(function (link) {
            link.addEventListener('shown.bs.tab', function () {
                link.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            });
        });
    }
</script>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
<script src="/js/admin-upload.js"></script>
</body>
</html>
