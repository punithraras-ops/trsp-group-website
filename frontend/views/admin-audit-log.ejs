<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Audit Log' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>;">

<div class="admin-topbar">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3" style="max-width: 900px;">
        <h1><i class="fas fa-clock-rotate-left me-2" style="color: var(--admin-accent);"></i>Admin Activity Log</h1>
        <div class="me-2"><%- include('partials/language-switcher') %></div>
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<main class="admin-page-main">
<div class="container pb-5" style="max-width: 900px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <p class="text-muted">The last <%= entries.length %> admin actions, most recent first.</p>
            <% if (entries.length === 0) { %>
                <p class="text-muted">No activity recorded yet.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr><th>When</th><th>Action</th><th>Details</th><th>IP</th></tr>
                        </thead>
                        <tbody>
                            <% entries.forEach(entry => { %>
                                <tr>
                                    <td class="text-nowrap"><%= new Date(entry.created_at).toLocaleString('en-IN') %></td>
                                    <td><span class="badge bg-secondary"><%= entry.action %></span></td>
                                    <td><%= entry.details %></td>
                                    <td class="text-muted small"><%= entry.ip %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
