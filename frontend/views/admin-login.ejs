<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= site.short_name %> - Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background: #0f172a;">
<div class="card border-0 shadow-lg rounded-4" style="width: 100%; max-width: 400px;">
    <div class="card-body p-4">
        <h3 class="fw-bold text-center mb-4">Admin Login</h3>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/admin/login">
            <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/admin' %>">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control form-control-lg" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control form-control-lg" required>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>
        </form>
        <div class="text-center mt-3">
            <a href="/admin/forgot-password">Forgot password?</a>
        </div>
    </div>
</div>
</body>
</html>
