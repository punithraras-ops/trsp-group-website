<%- include('partials/admin-head', { adminPageTitle: site.short_name + ' - Admin Security' }) %>
<body class="admin-page" style="--admin-bg: <%= design.adminBackground %>; --admin-accent: <%= design.adminColors.admin_accent %>; --admin-accent-dark: <%= design.adminColors.admin_accent_dark %>; --admin-text: <%= design.adminColors.admin_text %>; --admin-surface: <%= design.adminColors.admin_surface %>;">

<div class="admin-topbar">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <% if (design.images.logo || site.icon_path) { %>
                <img src="<%= design.images.logo || site.icon_path %>" alt="<%= site.legal_name %> logo" class="admin-logo-mark">
            <% } %>
            <h1 class="mb-0"><i class="fas fa-shield-halved me-2" style="color: var(--admin-accent);"></i>Admin Security</h1>
        </div>
        <div class="me-2"><%- include('partials/language-switcher') %></div>
        <a href="/admin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>
</div>

<main class="admin-page-main">
<div class="container-fluid px-4 pb-5">

    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-key me-2" style="color: var(--admin-accent);"></i>Change Password</h4>
            <form method="POST" action="/admin/security/change-password">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input type="password" name="password" class="form-control" minlength="8" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" name="confirm_password" class="form-control" minlength="8" required>
                </div>
                <button type="submit" class="btn btn-primary">Update Password</button>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-mobile-screen-button me-2" style="color: var(--admin-accent);"></i>Two-Factor Authentication</h4>

            <% if (enabled) { %>
                <p class="text-success fw-bold">&#10003; Enabled</p>
                <p class="text-muted">Logging in now requires a code from your authenticator app. This is also what lets you recover your password if you forget it.</p>
                <form method="POST" action="/admin/security/disable">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3" style="max-width: 240px;">
                        <label class="form-label">Enter current code to disable</label>
                        <input type="text" name="code" class="form-control text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required>
                    </div>
                    <button type="submit" class="btn btn-outline-danger">Disable 2FA</button>
                </form>
            <% } else if (enrollment) { %>
                <p>1. Scan this QR code with Google Authenticator, Authy, or any TOTP app:</p>
                <div class="text-center mb-3">
                    <img src="<%= enrollment.qrDataUrl %>" alt="2FA QR code" style="width: 220px; height: 220px;">
                </div>
                <p>Or enter this code manually: <code><%= enrollment.secret %></code></p>
                <p class="mt-3">2. Enter the 6-digit code your app shows to confirm:</p>
                <form method="POST" action="/admin/security/confirm-enrollment" style="max-width: 240px;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <input type="text" name="code" class="form-control text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Confirm &amp; Enable</button>
                </form>
            <% } else { %>
                <p class="text-muted">Not enabled. Add an authenticator app for a second layer of login security, and to be able to reset your password yourself if you ever forget it.</p>
                <form method="POST" action="/admin/security/start-enrollment">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-primary">Enable 2FA</button>
                </form>
            <% } %>
        </div>
    </div>
</div>
</main>
<footer class="admin-footer">
    &copy; <%= new Date().getFullYear() %> <%= site.legal_name %>. Admin Panel.
</footer>
<script src="/js/click-sound.js"></script>
<script src="/js/translate-widget.js"></script>
</body>
</html>
